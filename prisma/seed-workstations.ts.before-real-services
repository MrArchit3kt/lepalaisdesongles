import "dotenv/config";

import { PrismaPg } from "@prisma/adapter-pg";
import { PrismaClient } from "../src/generated/prisma/client";

const databaseUrl = process.env.DATABASE_URL;

if (!databaseUrl) {
  throw new Error(
    "La variable d'environnement DATABASE_URL est absente.",
  );
}

const adapter = new PrismaPg({
  connectionString: databaseUrl,
});

const prisma = new PrismaClient({
  adapter,
});

type WorkstationDefinition = {
  name: string;
  slug: string;
  description: string;
  sortOrder: number;
  compatibility:
    | "ALL"
    | "MANICURE"
    | "GEL"
    | "NAIL_ART"
    | "PEDICURE"
    | "REMOVAL";
};

const WORKSTATIONS: WorkstationDefinition[] = [
  {
    name: "Poste principal",
    slug: "poste-principal",
    description:
      "Poste principal réservé à la propriétaire du salon.",
    sortOrder: 0,
    compatibility: "ALL",
  },
  {
    name: "Poste employé",
    slug: "poste-employe",
    description:
      "Poste général attribué aux membres de l'équipe.",
    sortOrder: 1,
    compatibility: "ALL",
  },
  {
    name: "Poste polyvalent",
    slug: "poste-polyvalent",
    description:
      "Poste compatible avec l'ensemble des prestations du salon.",
    sortOrder: 2,
    compatibility: "ALL",
  },
  {
    name: "Poste manucure",
    slug: "poste-manucure",
    description:
      "Poste dédié aux manucures, semi-permanents et soins des mains.",
    sortOrder: 3,
    compatibility: "MANICURE",
  },
  {
    name: "Poste gel et extensions",
    slug: "poste-gel-extensions",
    description:
      "Poste dédié aux poses en gel, capsules, extensions et remplissages.",
    sortOrder: 4,
    compatibility: "GEL",
  },
  {
    name: "Poste Nail Art",
    slug: "poste-nail-art",
    description:
      "Poste dédié aux décorations, French, Baby-boomer et Nail Art.",
    sortOrder: 5,
    compatibility: "NAIL_ART",
  },
  {
    name: "Poste pédicure",
    slug: "poste-pedicure",
    description:
      "Poste réservé aux prestations et soins des pieds.",
    sortOrder: 6,
    compatibility: "PEDICURE",
  },
  {
    name: "Poste dépose et soins",
    slug: "poste-depose-soins",
    description:
      "Poste dédié aux déposes et aux soins des ongles naturels.",
    sortOrder: 7,
    compatibility: "REMOVAL",
  },
];

const MANICURE_SERVICE_SLUGS = new Set([
  "manucure-russe",
  "vernis-semi-permanent-mains",
  "gainage-ongles-naturels",
]);

const GEL_SERVICE_SLUGS = new Set([
  "pose-complete-gel",
  "pose-americaine",
  "remplissage-gel",
]);

const NAIL_ART_SERVICE_SLUGS = new Set([
  "french-manucure",
  "baby-boomer",
  "nail-art-simple",
  "nail-art-complexe",
]);

const PEDICURE_SERVICE_SLUGS = new Set([
  "semi-permanent-pieds",
  "depose-semi-permanent-pieds",
]);

const REMOVAL_SERVICE_SLUGS = new Set([
  "depose-semi-permanent",
  "depose-complete-gel",
  "depose-semi-permanent-pieds",
]);

function isServiceCompatible(
  compatibility: WorkstationDefinition["compatibility"],
  serviceSlug: string,
): boolean {
  if (compatibility === "ALL") {
    return true;
  }

  if (compatibility === "MANICURE") {
    return MANICURE_SERVICE_SLUGS.has(serviceSlug);
  }

  if (compatibility === "GEL") {
    return GEL_SERVICE_SLUGS.has(serviceSlug);
  }

  if (compatibility === "NAIL_ART") {
    return NAIL_ART_SERVICE_SLUGS.has(serviceSlug);
  }

  if (compatibility === "PEDICURE") {
    return PEDICURE_SERVICE_SLUGS.has(serviceSlug);
  }

  return REMOVAL_SERVICE_SLUGS.has(serviceSlug);
}

async function main(): Promise<void> {
  console.log("");
  console.log("Initialisation des postes de travail...");
  console.log("==========================================");

  const [services, owner, employees] =
    await Promise.all([
      prisma.service.findMany({
        where: {
          isActive: true,
          allowOnlineBooking: true,
        },
        select: {
          id: true,
          name: true,
          slug: true,
        },
        orderBy: {
          sortOrder: "asc",
        },
      }),

      prisma.staffProfile.findFirst({
        where: {
          isOwner: true,
          isActive: true,
          user: {
            status: "ACTIVE",
          },
        },
        select: {
          id: true,
          displayName: true,
        },
      }),

      prisma.staffProfile.findMany({
        where: {
          isOwner: false,
          isActive: true,
          user: {
            status: "ACTIVE",
          },
        },
        select: {
          id: true,
          displayName: true,
        },
      }),
    ]);

  if (services.length === 0) {
    throw new Error(
      "Aucune prestation active et réservable en ligne n'a été trouvée.",
    );
  }

  const createdWorkstations = new Map<
    string,
    {
      id: string;
      name: string;
      slug: string;
    }
  >();

  for (const definition of WORKSTATIONS) {
    const workstation =
      await prisma.workstation.upsert({
        where: {
          slug: definition.slug,
        },
        update: {
          name: definition.name,
          description: definition.description,
          isActive: true,
          availableForBooking: true,
          sortOrder: definition.sortOrder,
        },
        create: {
          name: definition.name,
          slug: definition.slug,
          description: definition.description,
          isActive: true,
          availableForBooking: true,
          sortOrder: definition.sortOrder,
        },
        select: {
          id: true,
          name: true,
          slug: true,
        },
      });

    createdWorkstations.set(
      definition.slug,
      workstation,
    );

    const compatibleServices = services.filter(
      (service) =>
        isServiceCompatible(
          definition.compatibility,
          service.slug,
        ),
    );

    if (compatibleServices.length > 0) {
      await prisma.workstationService.createMany({
        data: compatibleServices.map((service) => ({
          workstationId: workstation.id,
          serviceId: service.id,
          isActive: true,
        })),
        skipDuplicates: true,
      });

      await prisma.workstationService.updateMany({
        where: {
          workstationId: workstation.id,
          serviceId: {
            in: compatibleServices.map(
              (service) => service.id,
            ),
          },
        },
        data: {
          isActive: true,
        },
      });
    }

    console.log(
      `✓ ${workstation.name} : ${compatibleServices.length} prestation(s) compatible(s)`,
    );
  }

  const principalWorkstation =
    createdWorkstations.get("poste-principal");

  const employeeWorkstation =
    createdWorkstations.get("poste-employe");

  if (!principalWorkstation) {
    throw new Error(
      "Le Poste principal n'a pas pu être créé.",
    );
  }

  if (!employeeWorkstation) {
    throw new Error(
      "Le Poste employé n'a pas pu être créé.",
    );
  }

  /*
   * Attribution automatique du Poste principal
   * au compte propriétaire déjà présent.
   */
  if (owner) {
    await prisma.staffWorkstation.upsert({
      where: {
        staffId_workstationId: {
          staffId: owner.id,
          workstationId: principalWorkstation.id,
        },
      },
      update: {
        isPrimary: true,
        isActive: true,
      },
      create: {
        staffId: owner.id,
        workstationId: principalWorkstation.id,
        isPrimary: true,
        isActive: true,
      },
    });

    console.log(
      `✓ Poste principal attribué à ${
        owner.displayName ?? "la propriétaire"
      }`,
    );
  } else {
    console.log(
      "⚠ Aucune propriétaire active trouvée.",
    );
  }

  /*
   * Les employées déjà présentes qui ne possèdent aucun poste
   * reçoivent automatiquement le Poste employé.
   *
   * Les affectations existantes ne sont pas écrasées.
   */
  for (const employee of employees) {
    const assignmentCount =
      await prisma.staffWorkstation.count({
        where: {
          staffId: employee.id,
          isActive: true,
        },
      });

    if (assignmentCount > 0) {
      console.log(
        `→ ${employee.displayName ?? "Employée"} possède déjà un poste`,
      );

      continue;
    }

    await prisma.staffWorkstation.create({
      data: {
        staffId: employee.id,
        workstationId: employeeWorkstation.id,
        isPrimary: true,
        isActive: true,
      },
    });

    console.log(
      `✓ Poste employé attribué à ${
        employee.displayName ?? "une employée"
      }`,
    );
  }

  console.log("==========================================");
  console.log(
    `✓ ${WORKSTATIONS.length} postes disponibles`,
  );
  console.log(
    `✓ ${services.length} prestations analysées`,
  );
  console.log("Initialisation terminée.");
  console.log("");
}

main()
  .catch((error: unknown) => {
    console.error(
      "Erreur pendant l'initialisation des postes :",
      error,
    );

    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
