    },
    {
      sourceId: "demo-google-review-2",
      authorName: "Laura B.",
      rating: 5,
      title: "Résultat impeccable",
      content:
        "Accueil chaleureux, salon très propre et résultat impeccable. Mes ongles n’ont jamais été aussi beaux.",
      isVerified: true,
      isFeatured: true,
    },
    {
      sourceId: "demo-google-review-3",
      authorName: "Camille R.",
      rating: 5,
      title: "Je reviendrai",
      content:
        "Elle a parfaitement compris le modèle que je souhaitais. Le nail art est précis et élégant. Je reviendrai.",
      isVerified: true,
      isFeatured: true,
    },
  ];

  for (const review of reviews) {
    const existingReview = await prisma.review.findFirst({
      where: {
        source: ReviewSource.GOOGLE,
        sourceId: review.sourceId,
      },
    });

    if (existingReview) {
      await prisma.review.update({
        where: {
          id: existingReview.id,
        },
        data: {
          ...review,
          source: ReviewSource.GOOGLE,
          status: ReviewStatus.APPROVED,
          publishedAt: existingReview.publishedAt ?? new Date(),
        },
      });
    } else {
      await prisma.review.create({
        data: {
          ...review,
          source: ReviewSource.GOOGLE,
          status: ReviewStatus.APPROVED,
          publishedAt: new Date(),
        },
      });
    }
  }

  console.log(`✓ ${reviews.length} avis de démonstration créés`);
}

