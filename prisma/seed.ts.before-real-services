async function seedAdmin() {
  const passwordHash = await bcrypt.hash(adminPassword, 12);

  const admin = await prisma.user.upsert({
    where: {
      email: adminEmail,
    },
    update: {
      firstName: adminFirstName,
      lastName: adminLastName,
      passwordHash,
      role: UserRole.SUPER_ADMIN,
      status: UserStatus.ACTIVE,

      /*
       * Le seed remplace le hash du mot de passe.
       * Les sessions existantes doivent donc être révoquées.
       */
      authVersion: {
        increment: 1,
      },
    },
    create: {
      email: adminEmail,
      firstName: adminFirstName,
      lastName: adminLastName,
      passwordHash,
      role: UserRole.SUPER_ADMIN,
      status: UserStatus.ACTIVE,
      emailVerified: new Date(),
    },
  });

  console.log(`✓ Administrateur créé ou mis à jour : ${admin.email}`);

  return admin;
}

async function seedWorkingHours() {
  for (const workingHour of workingHours) {
    await prisma.workingHour.upsert({
      where: {
        dayOfWeek: workingHour.dayOfWeek,
      },
      update: workingHour,
      create: workingHour,
    });
  }

  console.log(`✓ ${workingHours.length} journées de travail configurées`);
}

async function seedCategoriesAndServices() {
  let numberOfServices = 0;

  const seededServiceSlugs = categories.flatMap(
    (category) =>
      category.services.map(
        (service) => service.slug,
      ),
  );

  const seededCategorySlugs = categories.map(
    (category) => category.slug,
  );

  /*
   * Les anciennes prestations restent en base afin de préserver
   * les rendez-vous existants, mais elles ne sont plus proposées.
   */
  await prisma.service.updateMany({
    where: {
      slug: {
        notIn: seededServiceSlugs,
      },
    },
    data: {
      isActive: false,
      isFeatured: false,
      allowOnlineBooking: false,
    },
  });

  await prisma.serviceCategory.updateMany({
    where: {
      slug: {
        notIn: seededCategorySlugs,
      },
    },
    data: {
      isActive: false,
    },
  });

  for (const categoryData of categories) {
    const { services, ...category } = categoryData;

    const savedCategory = await prisma.serviceCategory.upsert({
      where: {
        slug: category.slug,
      },
      update: category,
      create: category,
    });

    for (const service of services) {
      await prisma.service.upsert({
        where: {
          slug: service.slug,
        },
        update: {
          ...service,
          categoryId: savedCategory.id,
        },
        create: {
          ...service,
          categoryId: savedCategory.id,
        },
      });

      numberOfServices += 1;
    }
  }

  console.log(`✓ ${categories.length} catégories de prestations créées`);
  console.log(`✓ ${numberOfServices} prestations créées`);
}

