  description String?

  // ==========================
  // ORIGINE MÉTIER
  // ==========================

  sourceEntityType String?
  sourceEntityId   String?

  appointmentReference String?
  contestReference     String?
  rewardReference      String?
  challengeReference   String?

  // Empêche une même action de créditer deux fois les points.
  idempotencyKey String? @unique

  // ==========================
  // EXPIRATION
  // ==========================

  expiresAt DateTime?
  expiredAt DateTime?

