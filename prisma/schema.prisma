  // ANNULATION ET CORRECTION
  // ==========================

  isReversed     Boolean   @default(false)
  reversedAt     DateTime?
  reversalReason String?

  reversalOfId String? @unique

  reversalOf LoyaltyTransaction? @relation("LoyaltyTransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)

  reversedBy LoyaltyTransaction? @relation("LoyaltyTransactionReversal")

  // ==========================
  // TRAÇABILITÉ
  // ==========================

  actorId   String?
  actorName String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================
  // INDEX
  // ==========================

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
  @@index([sourceEntityType, sourceEntityId])
  @@index([expiresAt])
  @@index([isReversed])
}

