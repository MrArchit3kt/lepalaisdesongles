model LoyaltyTransaction {
  id String @id @default(cuid())

  // ==========================
  // CLIENT ET COMPTE VIP
  // ==========================

  userId    String
  accountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // ==========================
  // TYPE DE MOUVEMENT
  // ==========================

  type   LoyaltyTransactionType
  source LoyaltyTransactionSource

  // ==========================
  // VALEURS DU MOUVEMENT
  // ==========================

  xpAmount     Int @default(0)
  pointsAmount Int @default(0)

  // Solde du compte après cette transaction.
  xpBalanceAfter     Int
  pointsBalanceAfter Int

  // ==========================
  // MULTIPLICATEURS
  // ==========================

  baseXpAmount     Int?
  basePointsAmount Int?

  xpMultiplier     Decimal @default(1.00) @db.Decimal(6, 2)
  pointsMultiplier Decimal @default(1.00) @db.Decimal(6, 2)

