model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  image        String?
  role         UserRole   @default(CLIENT)
  status       UserStatus @default(ACTIVE)

  // Incrémenté lors d’un changement sensible :
  // mot de passe, rôle, statut ou adresse e-mail.
  // Tout JWT portant une ancienne version devient invalide.
  authVersion Int @default(0)

  emailVerified DateTime?
  phoneVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /**
   * Jeton secret permettant de s'abonner à son agenda (rendez-vous)
   * depuis une application de calendrier externe (ex. Calendrier
   * iPhone), sans session ni cookie — l'URL du flux ICS embarque ce
   * jeton. Généré à la demande, régénérable pour révoquer un lien
   * partagé par erreur.
   */
  calendarFeedToken String? @unique

  // ==========================
  // PROFILS
  // ==========================

  clientProfile ClientProfile?
  staffProfile  StaffProfile?

  // ==========================
  // RENDEZ-VOUS
  // ==========================

  appointments          Appointment[] @relation("ClientAppointments")
  processedAppointments Appointment[] @relation("AppointmentProcessor")

  // ==========================
  // CARTES CADEAUX
  // ==========================

  giftCardTransactions         GiftCardTransaction[] @relation("GiftCardTransactionActor")
  reversedGiftCardTransactions GiftCardTransaction[] @relation("GiftCardTransactionReverser")

  // ==========================
  // GALERIE
  // ==========================

  createdGalleryItems GalleryItem[] @relation("GalleryCreator")

  // ==========================
  // AVIS
  // ==========================

  reviews         Review[] @relation("ReviewAuthor")
  reviewResponses Review[] @relation("ReviewResponder")

  // ==========================
  // MESSAGERIE
  // ==========================

  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")

  // ==========================
  // PROMOTIONS
  // ==========================

  createdPromotions Promotion[] @relation("PromotionCreator")

  // ==========================
  // CONCOURS
  // ==========================

  createdContests       Contest[]            @relation("ContestCreator")
  contestParticipations ContestParticipant[]

  contestPointEntries ContestPointEntry[]
  contestVotes        ContestVote[]
  contestWins         ContestWinner[]

  // ==========================
  // CLUB VIP
  // ==========================

  loyaltyAccount      LoyaltyAccount?
  loyaltyTransactions LoyaltyTransaction[]

  clientBadges       ClientBadge[]
  clientAchievements ClientAchievement[]
  clientRewards      ClientReward[]
  clientChallenges   ClientChallenge[]
  clientSeasonPasses ClientSeasonPass[]

  referralsSent     Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferred")

  vipTeamMemberships VipTeamMember[]

  vipGiftTransfersSent     VipGiftTransfer[] @relation("VipGiftSender")
  vipGiftTransfersReceived VipGiftTransfer[] @relation("VipGiftRecipient")

  vipShopPurchases VipShopPurchase[]

  createdVipConfigurations VipConfiguration[] @relation("VipConfigurationCreator")
  updatedVipConfigurations VipConfiguration[] @relation("VipConfigurationUpdater")

  createdVipRules  VipAutomationRule[] @relation("VipRuleCreator")
  createdVipEvents VipEvent[]          @relation("VipEventCreator")

  marketingRecommendationsApplied MarketingRecommendation[] @relation("MarketingRecommendationAppliedBy")

  marketingRecommendationsDismissed MarketingRecommendation[] @relation("MarketingRecommendationDismissedBy")

  vipAuditEntries VipAuditLog[]

  // ==========================
  // NOTIFICATIONS
  // ==========================

  notifications Notification[]

  // ==========================
  // CONTACT
  // ==========================

  contactMessages ContactMessage[]

  // ==========================
  // AUDIT
  // ==========================

  auditLogs AuditLog[] @relation("AuditLogActor")

  // ==========================
  // HORAIRES
  // ==========================

  createdTimeOffs TimeOff[] @relation("TimeOffCreator")

  createdWorkingHourOverrides WorkingHourOverride[] @relation("WorkingHourOverrideCreator")

  // ==========================
  // INDEX
  // ==========================

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model ClientProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  birthDate      DateTime?
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  city           String?
  country        String    @default("France")
  allergies      String?
  internalNotes  String?
  marketingEmail Boolean   @default(false)
  marketingSms   Boolean   @default(false)
  loyaltyPoints  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@index([isActive, sortOrder])
}

model Service {
  id                    String   @id @default(cuid())
  categoryId            String
  name                  String
  slug                  String   @unique
  shortDescription      String?
  description           String?
  priceCents            Int?
  promotionalPriceCents Int?
  durationMinutes       Int
  cleanupMinutes        Int      @default(0)
  depositRequired       Boolean  @default(false)
  depositCents          Int?
  imageUrl              String?
  color                 String?
  isActive              Boolean  @default(true)
  isFeatured            Boolean  @default(false)
  allowOnlineBooking    Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category            ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images              ServiceImage[]
  appointmentItems    AppointmentService[]
  promotionServices   PromotionService[]
  staffServices       StaffService[]
  workstationServices WorkstationService[]

  @@index([categoryId])
  @@index([isActive, sortOrder])
  @@index([isFeatured])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
}

model StaffProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  displayName           String?
  bio                   String?
  color                 String?
  isOwner               Boolean  @default(false)
  isActive              Boolean  @default(true)
  acceptsOnlineBooking  Boolean  @default(true)
  defaultCleanupMinutes Int      @default(0)
  slotIntervalMinutes   Int      @default(15)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               StaffService[]
  workingHours           StaffWorkingHour[]
  overrides              StaffWorkingHourOverride[]
  timeOffs               StaffTimeOff[]
  appointments           Appointment[]
  workstationAssignments StaffWorkstation[]

  @@index([isActive, acceptsOnlineBooking, sortOrder])
  @@index([isOwner])
}

model StaffService {
  id              String   @id @default(cuid())
  staffId         String
  serviceId       String
  isActive        Boolean  @default(true)
  durationMinutes Int?
  cleanupMinutes  Int?
  priceCents      Int?
  depositRequired Boolean?
  depositCents    Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([serviceId, isActive])
  @@index([staffId, isActive, sortOrder])
}

model Workstation {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  color               String?
  isActive            Boolean  @default(true)
  availableForBooking Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  staffAssignments   StaffWorkstation[]
  serviceAssignments WorkstationService[]
  appointments       Appointment[]

  @@index([isActive, availableForBooking, sortOrder])
}

model StaffWorkstation {
  staffId       String
  workstationId String
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workstation Workstation  @relation(fields: [workstationId], references: [id], onDelete: Cascade)

  @@id([staffId, workstationId])
  @@index([workstationId, isActive])
  @@index([staffId, isPrimary, isActive])
}

model WorkstationService {
  workstationId String
  serviceId     String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workstation Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([workstationId, serviceId])
  @@index([serviceId, isActive])
  @@index([workstationId, isActive])
}

model StaffWorkingHour {
  id         String    @id @default(cuid())
  staffId    String
  dayOfWeek  DayOfWeek
  isOpen     Boolean   @default(true)
  startTime  String?
  endTime    String?
  hasBreak   Boolean   @default(false)
  breakStart String?
  breakEnd   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId, isOpen])
}

model StaffWorkingHourOverride {
  id         String   @id @default(cuid())
  staffId    String
  date       DateTime @db.Date
  isOpen     Boolean  @default(false)
  startTime  String?
  endTime    String?
  hasBreak   Boolean  @default(false)
  breakStart String?
  breakEnd   String?
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date])
  @@index([staffId, date])
}

model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  title     String
  reason    String?
  startsAt  DateTime
  endsAt    DateTime
  allDay    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

model WorkingHour {
  id         String    @id @default(cuid())
  dayOfWeek  DayOfWeek @unique
  isOpen     Boolean   @default(true)
  startTime  String?
  endTime    String?
  breakStart String?
  breakEnd   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model WorkingHourOverride {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  isOpen      Boolean  @default(false)
  startTime   String?
  endTime     String?
  breakStart  String?
  breakEnd    String?
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("WorkingHourOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([date])
  @@index([date])
}

model TimeOff {
  id          String   @id @default(cuid())
  title       String
  reason      String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("TimeOffCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startsAt, endsAt])
}

model Appointment {
  id                   String            @id @default(cuid())
  reference            String            @unique
  clientId             String
  staffId              String?
  workstationId        String?
  processedById        String?
  status               AppointmentStatus @default(PENDING)
  startsAt             DateTime
  endsAt               DateTime
  totalDurationMinutes Int
  totalPriceCents      Int
  depositCents         Int               @default(0)
  paymentStatus        PaymentStatus     @default(NOT_REQUIRED)
  paymentMethod        PaymentMethod?

  /**
   * Date limite au-delà de laquelle un rendez-vous PENDING dont
   * l'acompte n'a pas été réglé est automatiquement expiré (voir
   * `appointment-expiration.service.ts`). Nulle si aucun acompte
   * n'est requis ou si le paiement a déjà été enregistré.
   */
  expiresAt DateTime?

  // Code promo éventuellement appliqué sur la page de paiement de
  // l'acompte : `discountCents` conserve la réduction appliquée sur
  // `totalPriceCents` à titre d'historique/affichage.
  promotionId   String?
  discountCents Int     @default(0)

  clientComment      String?
  adminComment       String?
  cancellationReason String?
  paypalOrderId      String? @unique
  paypalCaptureId    String?
  paypalPayerId      String?

  paypalRefundId        String?   @unique
  paypalRefundRequestId String?   @unique
  paypalRefundStatus    String?
  refundRequestedAt     DateTime?
  refundedAmountCents   Int       @default(0)
  refundedAt            DateTime?
  refundReason          String?
  refundedById          String?

  paidAt              DateTime?
  confirmedAt         DateTime?
  refusedAt           DateTime?
  cancelledAt         DateTime?
  completedAt         DateTime?
  reminderSentAt      DateTime?
  reminder2hSentAt    DateTime?
  reviewRequestSentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client      User          @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Restrict)
  staff       StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
