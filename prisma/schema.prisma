model MarketingRecommendation {
  id String @id @default(cuid())

  title       String
  description String

  category MarketingRecommendationCategory
  priority MarketingRecommendationPriority @default(MEDIUM)
  status   MarketingRecommendationStatus   @default(NEW)

  reason String?

  expectedImpact       String?
  expectedRevenueCents Int?
  confidenceScore      Int?

  recommendedAction Json?
  analysisData      Json?

  targetEntityType String?
  targetEntityId   String?

  appliedById   String?
  dismissedById String?

  viewedAt    DateTime?
  acceptedAt  DateTime?
  appliedAt   DateTime?
  dismissedAt DateTime?
  expiresAt   DateTime?
  failedAt    DateTime?

  dismissalReason String?
  failureReason   String?

  resultData Json?
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appliedBy   User? @relation("MarketingRecommendationAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  dismissedBy User? @relation("MarketingRecommendationDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([category, status])
  @@index([appliedById])
  @@index([dismissedById])
  @@index([targetEntityType, targetEntityId])
  @@index([expiresAt])
  @@index([createdAt])
}

model SecurityUpload {
  id                String    @id @default(cuid())
  key               String    @unique
  url               String
  uploadedById      String
  purpose           String
  fileName          String?
  mimeType          String
  sizeBytes         Int
  claimedAt         DateTime?
  claimedEntityType String?
  claimedEntityId   String?
  expiresAt         DateTime

  // Nettoyage des fichiers expirés non revendiqués.
  cleanupRunId     String?
  cleanupStartedAt DateTime?
  cleanupAttempts  Int       @default(0)
  cleanupLastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById, purpose, claimedAt])
  @@index([claimedEntityType, claimedEntityId])
  @@index([claimedAt, expiresAt, cleanupStartedAt])
  @@index([cleanupRunId])
  @@index([expiresAt])
  @@index([createdAt])
}

// ============================================================================
// CARTES CADEAUX
// ============================================================================
//
// Module indépendant :
// - achat en ligne avec PayPal ;
// - utilisation exclusivement en magasin ;
// - aucun lien avec les rendez-vous ou la réservation en ligne ;
// - débit partiel autorisé ;
// - historique complet de chaque opération.
// ============================================================================

model GiftCard {
  id        String         @id @default(cuid())
  reference String         @unique
  code      String         @unique
  status    GiftCardStatus @default(PENDING_PAYMENT)

  initialAmountCents Int
  balanceCents       Int
  currency           String @default("EUR")

  purchaserFirstName String
  purchaserLastName  String
  purchaserEmail     String

  recipientFirstName String
  recipientLastName  String
  recipientEmail     String?

  personalMessage String?

  paypalOrderId   String? @unique
  paypalCaptureId String? @unique
  paypalPayerId   String?

  checkoutTokenHash String?
  version           Int     @default(0)

  paidAt      DateTime?
  activatedAt DateTime?
  fullyUsedAt DateTime?
  cancelledAt DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime

  cancellationReason String?
  revocationReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions GiftCardTransaction[]

  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([purchaserEmail])
  @@index([recipientEmail])
  @@index([createdAt])
}

model GiftCardTransaction {
  id         String                  @id @default(cuid())
  giftCardId String
  type       GiftCardTransactionType

  amountCents        Int @default(0)
  balanceBeforeCents Int
  balanceAfterCents  Int

  note   String?
  reason String?

  actorId String?

  paypalOrderId   String?
  paypalCaptureId String?

  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  metadata Json?

  createdAt DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  actor User? @relation("GiftCardTransactionActor", fields: [actorId], references: [id], onDelete: SetNull)

  reversedBy User? @relation("GiftCardTransactionReverser", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@index([type, createdAt])
  @@index([actorId, createdAt])
  @@index([paypalOrderId])
  @@index([paypalCaptureId])
}
