import Link from "next/link";
import { notFound } from "next/navigation";
import {
  CalendarCheck2,
  CalendarDays,
  CheckCircle2,
  Clock3,
  CreditCard,
  Download,
  Home,
  MapPin,
  ReceiptText,
  UserRound,
} from "lucide-react";

import { prisma } from "@/lib/prisma";

type ConfirmationPageProps = {
  params: Promise<{
    reference: string;
  }>;
};

function formatCurrency(cents: number): string {
  return new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR",
  }).format(cents / 100);
}

function formatDate(value: Date): string {
  return new Intl.DateTimeFormat("fr-FR", {
    timeZone: "Europe/Paris",
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(value);
}

function formatTime(value: Date): string {
  return new Intl.DateTimeFormat("fr-FR", {
    timeZone: "Europe/Paris",
    hour: "2-digit",
    minute: "2-digit",
  }).format(value);
}

function getStatusContent(
  status: string,
  paymentStatus: string,
  isFullPayment: boolean,
) {
  if (status === "CONFIRMED") {
    return {
      title: "Votre rendez-vous est confirmé",
      description:
        paymentStatus === "PAID"
          ? isFullPayment
            ? "Votre paiement intégral a bien été reçu. Votre créneau est définitivement réservé."
            : "Votre acompte de 35 € a bien été reçu. Votre créneau est définitivement réservé."
          : "Votre créneau a bien été réservé.",
      badge: "Rendez-vous confirmé",
      badgeClass:
        "border-emerald-200 bg-emerald-50 text-emerald-700",
      iconClass:
        "bg-emerald-100 text-emerald-700",
    };
  }

  if (status === "PENDING") {
    return {
      title: "Votre rendez-vous est en attente",
      description:
        isFullPayment
          ? "Votre réservation sera confirmée après le règlement intégral."
          : "Votre réservation sera confirmée après le règlement de l’acompte de 35 €.",
      badge: "Paiement en attente",
      badgeClass:
        "border-amber-200 bg-amber-50 text-amber-700",
      iconClass:
        "bg-amber-100 text-amber-700",
    };
  }

  if (
    status === "CANCELLED_BY_CLIENT" ||
    status === "CANCELLED_BY_ADMIN"
  ) {
    return {
      title: "Ce rendez-vous est annulé",
      description:
        "Cette réservation n’est plus active. Vous pouvez effectuer une nouvelle demande.",
      badge: "Rendez-vous annulé",
      badgeClass:
        "border-red-200 bg-red-50 text-red-700",
      iconClass:
        "bg-red-100 text-red-700",
    };
  }

  return {
    title: "Votre demande a bien été enregistrée",
    description:
      "Le salon a bien reçu votre demande de rendez-vous.",
    badge: "Demande enregistrée",
    badgeClass:
      "border-neutral-200 bg-neutral-50 text-neutral-700",
    iconClass:
      "bg-neutral-100 text-neutral-700",
  };
}

export default async function ConfirmationPage({
  params,
}: ConfirmationPageProps) {
  const { reference } = await params;

  const appointment =
    await prisma.appointment.findUnique({
      where: {
        reference,
      },

      select: {
        id: true,
        reference: true,
        status: true,
        paymentStatus: true,
        paymentMethod: true,

        startsAt: true,
        endsAt: true,

        totalPriceCents: true,
        depositCents: true,
        paidAt: true,

        client: {
          select: {
            firstName: true,
            lastName: true,
          },
        },

        staff: {
          select: {
            displayName: true,

            user: {
              select: {
                firstName: true,
                lastName: true,
              },
            },
          },
        },

        services: {
          orderBy: {
            sortOrder: "asc",
          },

          select: {
            id: true,
            serviceName: true,
            unitPriceCents: true,
            durationMinutes: true,
            quantity: true,
          },
        },
      },
    });

  if (!appointment) {
    notFound();
  }

  const isFullPayment =
    appointment.depositCents ===
    appointment.totalPriceCents;

  const paidAmountCents =
    appointment.paymentStatus === "PAID"
      ? appointment.depositCents
      : 0;

  const remainingCents = Math.max(
    appointment.totalPriceCents -
      paidAmountCents,
    0,
  );

  const statusContent = getStatusContent(
    appointment.status,
    appointment.paymentStatus,
    isFullPayment,
  );

  const clientName = [
    appointment.client.firstName,
    appointment.client.lastName,
  ]
    .filter(Boolean)
    .join(" ");

  const staffName =
    appointment.staff?.displayName?.trim() ||
    [
      appointment.staff?.user.firstName,
      appointment.staff?.user.lastName,
    ]
      .filter(Boolean)
      .join(" ") ||
    "Le Palais des Ongles";

  const canPay =
    appointment.status === "PENDING" &&
    appointment.paymentStatus !== "PAID" &&
    appointment.depositCents > 0;

  const canDownloadCalendar =
    appointment.status === "CONFIRMED";

  return (
    <main className="min-h-screen bg-neutral-50 px-4 py-10 sm:px-6 lg:py-16">
      <div className="mx-auto max-w-5xl">
        <section className="overflow-hidden rounded-3xl border border-neutral-200 bg-white shadow-sm">
          <div className="border-b border-neutral-100 px-6 py-10 text-center sm:px-10">
            <div
              className={`mx-auto flex size-16 items-center justify-center rounded-full ${statusContent.iconClass}`}
            >
              <CheckCircle2 className="size-8" />
            </div>

            <span
              className={`mt-6 inline-flex rounded-full border px-3 py-1.5 text-xs font-semibold ${statusContent.badgeClass}`}
            >
              {statusContent.badge}
            </span>

            <h1 className="mt-5 text-3xl font-semibold tracking-tight text-neutral-950 sm:text-4xl">
              {statusContent.title}
            </h1>

            <p className="mx-auto mt-4 max-w-2xl text-sm leading-6 text-neutral-600 sm:text-base">
              {statusContent.description}
            </p>

            <p className="mt-5 text-sm text-neutral-500">
              Référence{" "}
              <span className="font-semibold text-neutral-950">
                {appointment.reference}
              </span>
            </p>
          </div>

          <div className="grid gap-8 p-6 sm:p-10 lg:grid-cols-[1.15fr_0.85fr]">
            <div>
              <h2 className="text-xl font-semibold text-neutral-950">
                Détails du rendez-vous
              </h2>

              <div className="mt-5 grid gap-4 sm:grid-cols-2">
                <div className="flex gap-3 rounded-2xl bg-neutral-50 p-4">
                  <CalendarDays className="mt-0.5 size-5 shrink-0 text-rose-700" />

                  <div>
                    <p className="text-xs font-medium uppercase tracking-wide text-neutral-500">
                      Date
                    </p>

                    <p className="mt-1 text-sm font-semibold capitalize text-neutral-900">
                      {formatDate(
                        appointment.startsAt,
                      )}
                    </p>
                  </div>
                </div>

                <div className="flex gap-3 rounded-2xl bg-neutral-50 p-4">
                  <Clock3 className="mt-0.5 size-5 shrink-0 text-rose-700" />

                  <div>
                    <p className="text-xs font-medium uppercase tracking-wide text-neutral-500">
                      Horaire
                    </p>

                    <p className="mt-1 text-sm font-semibold text-neutral-900">
                      {formatTime(
                        appointment.startsAt,
                      )}
                      {" – "}
                      {formatTime(
                        appointment.endsAt,
                      )}
                    </p>
                  </div>
                </div>

                <div className="flex gap-3 rounded-2xl bg-neutral-50 p-4">
                  <UserRound className="mt-0.5 size-5 shrink-0 text-rose-700" />

                  <div>
                    <p className="text-xs font-medium uppercase tracking-wide text-neutral-500">
                      Cliente
                    </p>

                    <p className="mt-1 text-sm font-semibold text-neutral-900">
                      {clientName}
                    </p>
                  </div>
                </div>

                <div className="flex gap-3 rounded-2xl bg-neutral-50 p-4">
                  <CalendarCheck2 className="mt-0.5 size-5 shrink-0 text-rose-700" />

                  <div>
                    <p className="text-xs font-medium uppercase tracking-wide text-neutral-500">
                      Professionnelle
                    </p>

                    <p className="mt-1 text-sm font-semibold text-neutral-900">
                      {staffName}
                    </p>
                  </div>
                </div>
              </div>

              <div className="mt-8">
                <h2 className="text-xl font-semibold text-neutral-950">
                  Prestations
                </h2>

                <div className="mt-4 divide-y divide-neutral-100 rounded-2xl border border-neutral-100 px-5">
                  {appointment.services.map(
                    (service) => (
                      <div
                        key={service.id}
                        className="flex items-start justify-between gap-4 py-4"
                      >
                        <div>
                          <p className="font-medium text-neutral-900">
                            {service.serviceName}
                          </p>

                          <p className="mt-1 text-xs text-neutral-500">
                            {service.durationMinutes} min
                            {service.quantity > 1
                              ? ` × ${service.quantity}`
                              : ""}
                          </p>
                        </div>

                        <p className="shrink-0 text-sm font-semibold text-neutral-900">
                          {formatCurrency(
                            service.unitPriceCents *
                              service.quantity,
                          )}
                        </p>
                      </div>
                    ),
                  )}
                </div>
              </div>
            </div>

            <aside className="h-fit rounded-3xl border border-neutral-200 bg-neutral-50 p-6">
              <div className="flex items-center gap-3">
                <ReceiptText className="size-6 text-rose-700" />

                <h2 className="text-xl font-semibold text-neutral-950">
                  Paiement
                </h2>
              </div>

              <div className="mt-6 space-y-4">
                <div className="flex items-center justify-between text-sm text-neutral-600">
                  <span>Total</span>

                  <span className="font-medium text-neutral-900">
                    {formatCurrency(
                      appointment.totalPriceCents,
                    )}
                  </span>
                </div>

                <div className="flex items-center justify-between text-sm text-neutral-600">
                  <span>
                    {isFullPayment
                      ? "Paiement demandé"
                      : "Acompte demandé"}
                  </span>

                  <span className="font-medium text-neutral-900">
                    {formatCurrency(
                      appointment.depositCents,
                    )}
                  </span>
                </div>

                <div className="flex items-center justify-between border-t border-neutral-200 pt-4">
                  <span className="font-semibold text-neutral-950">
                    Statut
                  </span>

                  <span
                    className={
                      appointment.paymentStatus ===
                      "PAID"
                        ? "font-semibold text-emerald-700"
                        : "font-semibold text-amber-700"
                    }
                  >
                    {appointment.paymentStatus ===
                    "PAID"
                      ? isFullPayment
                        ? "Paiement intégral reçu"
                        : "Acompte reçu"
                      : appointment.paymentStatus ===
                          "NOT_REQUIRED"
                        ? "Aucun paiement requis"
                        : "En attente"}
                  </span>
                </div>

                {appointment.paymentStatus ===
                "PAID" ? (
                  <div className="rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
                    <div className="flex gap-3">
                      <CreditCard className="mt-0.5 size-5 shrink-0 text-emerald-700" />

                      <div>
                        <p className="text-sm font-semibold text-emerald-900">
                          {isFullPayment
                            ? "Paiement intégral reçu"
                            : "Acompte PayPal reçu"}
                        </p>

                        {appointment.paidAt ? (
                          <p className="mt-1 text-xs text-emerald-700">
                            Le{" "}
                            {formatDate(
                              appointment.paidAt,
                            )}{" "}
                            à{" "}
                            {formatTime(
                              appointment.paidAt,
                            )}
                          </p>
                        ) : null}
                      </div>
                    </div>
                  </div>
                ) : null}

                <div className="flex items-center justify-between border-t border-neutral-200 pt-4">
                  <span className="font-semibold text-neutral-950">
                    Solde restant
                  </span>

                  <span className="text-lg font-semibold text-rose-700">
                    {formatCurrency(
                      remainingCents,
                    )}
                  </span>
                </div>
              </div>

              <div className="mt-6 space-y-3">
                {canPay ? (
                  <Link
                    href={`/reservation/paiement/${appointment.reference}`}
                    className="flex w-full items-center justify-center gap-2 rounded-xl bg-rose-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-rose-800"
                  >
                    <CreditCard className="size-4" />
                    {isFullPayment
                      ? "Régler la réservation"
                      : "Régler l’acompte"}
                  </Link>
                ) : null}

                {canDownloadCalendar ? (
                  <a
                    href={`/api/appointments/${appointment.reference}/calendar`}
                    className="flex w-full items-center justify-center gap-2 rounded-xl border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-neutral-800 transition hover:bg-neutral-100"
                  >
                    <Download className="size-4" />
                    Ajouter au calendrier
                  </a>
                ) : null}

                <Link
                  href="/"
                  className="flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-medium text-neutral-600 transition hover:text-neutral-950"
                >
                  <Home className="size-4" />
                  Retour à l’accueil
                </Link>
              </div>

              <div className="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-amber-900">
                <p className="font-semibold">
                  Politique d&apos;annulation
                </p>

                <p className="mt-2">
                  Toute annulation effectuée moins
                  de 48 heures avant le rendez-vous
                  entraîne la perte de la somme
                  versée.
                </p>
              </div>

              <div className="mt-6 flex gap-3 border-t border-neutral-200 pt-6 text-xs leading-5 text-neutral-500">
                <MapPin className="mt-0.5 size-4 shrink-0" />

                <p>
                  Pensez à vous présenter quelques
                  minutes avant l’heure du
                  rendez-vous.
                </p>
              </div>
            </aside>
          </div>
        </section>
      </div>
    </main>
  );
}
