import {
  getServerSession,
} from "next-auth";
import {
  NextResponse,
} from "next/server";

import {
  createAppointment,
} from "@/features/booking/services/create-appointment.service";
import type {
  CreateAppointmentInput,
} from "@/features/booking/types/create-appointment.types";
import {
  authOptions,
} from "@/lib/auth";
import {
  consumeSecurityRateLimit,
  getClientIpAddress,
} from "@/lib/security/rate-limit";

export const runtime =
  "nodejs";

export const dynamic =
  "force-dynamic";

/* -------------------------------------------------------------------------- */
/*                              SÉCURITÉ ROUTE                                */
/* -------------------------------------------------------------------------- */

const MAX_REQUEST_BODY_BYTES =
  64 * 1024;

const ACCOUNT_MAX_REQUESTS =
  6;

const ACCOUNT_WINDOW_MS =
  15 * 60 * 1000;

const ACCOUNT_BLOCK_MS =
  30 * 60 * 1000;

const IP_MAX_REQUESTS =
  20;

const IP_WINDOW_MS =
  60 * 60 * 1000;

const IP_BLOCK_MS =
  60 * 60 * 1000;

function jsonResponse(
  body: Record<
    string,
    unknown
  >,
  status: number,
  additionalHeaders?: Record<
    string,
    string
  >,
) {
  return NextResponse.json(
    body,
    {
      status,

      headers: {
        "Cache-Control":
          "private, no-store, no-cache, max-age=0, must-revalidate",

        Pragma:
          "no-cache",

        ...additionalHeaders,
      },
    },
  );
}

function bodySize(
  value: string,
): number {
  return Buffer.byteLength(
    value,
    "utf8",
  );
}

/* -------------------------------------------------------------------------- */
/*                         CRÉATION DU RENDEZ-VOUS                             */
/* -------------------------------------------------------------------------- */

export async function POST(
  request: Request,
) {
  try {
    const session =
      await getServerSession(
        authOptions,
      );

    const user =
      session?.user;

    if (
      !user?.id
    ) {
      return jsonResponse(
        {
          message:
            "Vous devez être connectée pour réserver.",
        },
        401,
      );
    }

    if (
      user.status !==
        "ACTIVE" ||
      user.role !==
        "CLIENT"
    ) {
      return jsonResponse(
        {
          message:
            "Votre compte ne peut pas effectuer de réservation.",
        },
        403,
      );
    }

    const ipAddress =
      getClientIpAddress(
        request.headers,
      );

    const [
      accountRateLimit,
      ipRateLimit,
    ] =
      await Promise.all([
        consumeSecurityRateLimit({
          action:
            "APPOINTMENT_CREATE_ACCOUNT",

          subject:
            user.id,

          maxAttempts:
            ACCOUNT_MAX_REQUESTS,

          windowMs:
            ACCOUNT_WINDOW_MS,

          blockMs:
            ACCOUNT_BLOCK_MS,
        }),

        consumeSecurityRateLimit({
          action:
            "APPOINTMENT_CREATE_IP",

          subject:
            ipAddress,

          maxAttempts:
            IP_MAX_REQUESTS,

          windowMs:
            IP_WINDOW_MS,

          blockMs:
            IP_BLOCK_MS,
        }),
      ]);

    if (
      !accountRateLimit.allowed ||
      !ipRateLimit.allowed
    ) {
      const retryAfterSeconds =
        Math.max(
          accountRateLimit
            .retryAfterSeconds,

          ipRateLimit
            .retryAfterSeconds,

          1,
        );

      return jsonResponse(
        {
          message:
            "Trop de demandes de rendez-vous ont été effectuées. Réessayez plus tard.",

          code:
            "RATE_LIMITED",

          retryAfterSeconds,
        },
        429,
        {
          "Retry-After":
            String(
              retryAfterSeconds,
            ),
        },
      );
    }

    const contentType =
      request.headers
        .get(
          "content-type",
        )
        ?.toLowerCase();

    if (
      !contentType?.includes(
        "application/json",
      )
    ) {
      return jsonResponse(
        {
          message:
            "Le format de la requête n’est pas valide.",

          code:
            "UNSUPPORTED_MEDIA_TYPE",
        },
        415,
      );
    }

    const declaredLength =
      Number(
        request.headers.get(
          "content-length",
        ) ??
          0,
      );

    if (
      Number.isFinite(
        declaredLength,
      ) &&
      declaredLength >
        MAX_REQUEST_BODY_BYTES
    ) {
      return jsonResponse(
        {
          message:
            "La requête envoyée est trop volumineuse.",

          code:
            "REQUEST_TOO_LARGE",
        },
        413,
      );
    }

    let rawBody:
      string;

    try {
      rawBody =
        await request.text();
    } catch {
      return jsonResponse(
        {
          message:
            "Impossible de lire la requête.",

          code:
            "INVALID_REQUEST",
        },
        400,
      );
    }

    if (
      bodySize(
        rawBody,
      ) >
      MAX_REQUEST_BODY_BYTES
    ) {
      return jsonResponse(
        {
          message:
            "La requête envoyée est trop volumineuse.",

          code:
            "REQUEST_TOO_LARGE",
        },
        413,
      );
    }

    let body:
      Partial<CreateAppointmentInput>;

    try {
      body =
        JSON.parse(
          rawBody,
        ) as Partial<CreateAppointmentInput>;
    } catch {
      return jsonResponse(
        {
          message:
            "Le contenu JSON de la requête n’est pas valide.",

          code:
            "INVALID_JSON",
        },
        400,
      );
    }

    const serviceIds =
      Array.isArray(
        body.serviceIds,
      )
        ? body.serviceIds.filter(
            (
              serviceId,
            ): serviceId is string =>
              typeof serviceId ===
                "string" &&
              serviceId
                .trim()
                .length >
                0,
          )
        : [];

    const result =
      await createAppointment(
        user.id,
        {
          serviceIds,

          startsAt:
            typeof body.startsAt ===
            "string"
              ? body.startsAt.trim()
              : "",

          endsAt:
            typeof body.endsAt ===
            "string"
              ? body.endsAt.trim()
              : "",

          staffId:
            typeof body.staffId ===
            "string"
              ? body.staffId.trim()
              : "",

          workstationId:
            typeof body.workstationId ===
            "string"
              ? body.workstationId.trim()
              : "",

          clientComment:
            typeof body.clientComment ===
              "string" &&
            body.clientComment
              .trim()
              .length >
              0
              ? body.clientComment
                  .trim()
                  .slice(
                    0,
                    500,
                  )
              : null,
        },
      );

    return jsonResponse(
      result as unknown as Record<
        string,
        unknown
      >,
      201,
    );
  } catch (
    error: unknown
  ) {
    console.error(
      "CREATE_APPOINTMENT_ERROR",
      error,
    );

    const message =
      error instanceof
      Error
        ? error.message
        : "Impossible de créer le rendez-vous.";

    const slotUnavailableMessages = [
      "Ce créneau n'est plus disponible",
      "Ce créneau vient d'être réservé",
      "La durée des prestations a changé",
      "Le poste choisi n'est plus compatible",
      "Cette professionnelle ne réalise plus",
    ];

    const slotUnavailable =
      slotUnavailableMessages.some(
        (
          fragment,
        ) =>
          message.includes(
            fragment,
          ),
      );

    const publicBusinessMessages = [
      "Les données du rendez-vous sont invalides.",
      "Aucune prestation valide n'a été sélectionnée.",
      "La professionnelle sélectionnée est invalide.",
      "Le poste sélectionné est invalide.",
      "La date du rendez-vous est invalide.",
    ];

    const publicMessage =
      slotUnavailable
        ? message
        : publicBusinessMessages.includes(
              message,
            )
          ? message
          : "Impossible de créer le rendez-vous.";

    return jsonResponse(
      {
        message:
          publicMessage,

        code:
          slotUnavailable
            ? "SLOT_UNAVAILABLE"
            : "APPOINTMENT_CREATION_FAILED",
      },
      slotUnavailable
        ? 409
        : 400,
    );
  }
}
