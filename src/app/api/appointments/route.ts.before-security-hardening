import { NextResponse } from "next/server";
import { getServerSession } from "next-auth";

import { authOptions } from "@/lib/auth";
import { createAppointment } from "@/features/booking/services/create-appointment.service";
import type { CreateAppointmentInput } from "@/features/booking/types/create-appointment.types";

type AuthenticatedUser = {
  id?: string;
};

export async function POST(request: Request) {
  try {
    const session = await getServerSession(authOptions);
    const clientId = (session?.user as AuthenticatedUser | undefined)?.id;

    if (!clientId) {
      return NextResponse.json(
        {
          message: "Vous devez être connecté pour réserver.",
        },
        {
          status: 401,
        },
      );
    }

    const body = (await request.json()) as Partial<CreateAppointmentInput>;

    const serviceIds = Array.isArray(body.serviceIds)
      ? body.serviceIds.filter(
          (serviceId): serviceId is string =>
            typeof serviceId === "string" &&
            serviceId.trim().length > 0,
        )
      : [];

    const result = await createAppointment(clientId, {
      serviceIds,

      startsAt:
        typeof body.startsAt === "string"
          ? body.startsAt.trim()
          : "",

      endsAt:
        typeof body.endsAt === "string"
          ? body.endsAt.trim()
          : "",

      staffId:
        typeof body.staffId === "string"
          ? body.staffId.trim()
          : "",

      workstationId:
        typeof body.workstationId === "string"
          ? body.workstationId.trim()
          : "",

      clientComment:
        typeof body.clientComment === "string" &&
        body.clientComment.trim().length > 0
          ? body.clientComment.trim().slice(0, 500)
          : null,
    });

    return NextResponse.json(result, {
      status: 201,
    });
  } catch (error) {
    console.error("CREATE_APPOINTMENT_ERROR", error);

    const message =
      error instanceof Error
        ? error.message
        : "Impossible de créer le rendez-vous.";

    const slotUnavailableMessages = [
      "Ce créneau n'est plus disponible",
      "Ce créneau vient d'être réservé",
      "La durée des prestations a changé",
      "Le poste choisi n'est plus compatible",
      "Cette professionnelle ne réalise plus",
    ];

    const slotUnavailable =
      slotUnavailableMessages.some((fragment) =>
        message.includes(fragment),
      );

    const publicBusinessMessages = [
      "Les données du rendez-vous sont invalides.",
      "Aucune prestation valide n'a été sélectionnée.",
      "La professionnelle sélectionnée est invalide.",
      "Le poste sélectionné est invalide.",
      "La date du rendez-vous est invalide.",
    ];

    const publicMessage = slotUnavailable
      ? message
      : publicBusinessMessages.includes(message)
        ? message
        : "Impossible de créer le rendez-vous.";

    return NextResponse.json(
      {
        message: publicMessage,
        code: slotUnavailable
          ? "SLOT_UNAVAILABLE"
          : "APPOINTMENT_CREATION_FAILED",
      },
      {
        status: slotUnavailable ? 409 : 400,
      },
    );
  }
}