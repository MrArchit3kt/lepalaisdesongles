                </h2>
              </div>

              <div className="mt-6 space-y-4 text-sm">
                <div className="flex justify-between gap-4 text-[#75636A]">
                  <span>Total des prestations</span>

                  <strong className="text-[#241A1D]">
                    {formatCurrency(
                      appointment.totalPriceCents,
                    )}
                  </strong>
                </div>

                <div className="flex justify-between gap-4 text-[#75636A]">
                  <span>Montant versé</span>

                  <strong className="text-[#241A1D]">
                    {formatCurrency(
                      amountPaidCents,
                    )}
                  </strong>
                </div>

                <div className="flex justify-between gap-4 border-t border-[#241A1D]/10 pt-4">
                  <span className="font-semibold text-[#241A1D]">
                    Solde restant
                  </span>

                  <strong className="text-xl text-[#9D6F80]">
                    {formatCurrency(
                      remainingCents,
                    )}
                  </strong>
                </div>
              </div>

              <div className="mt-6 rounded-2xl bg-[#FFF9F8] p-4 text-sm">
                <div className="flex justify-between gap-4">
                  <span className="text-[#75636A]">
                    Statut
                  </span>

                  <strong className="text-[#241A1D]">
                    {appointment.paymentStatus ===
                    "PAID"
                      ? "Payé"
                      : appointment.paymentStatus ===
                          "PENDING"
                        ? "En attente"
                        : "Non réglé"}
                  </strong>
                </div>

                {appointment.paidAt ? (
                  <p className="mt-3 border-t border-[#241A1D]/8 pt-3 text-xs text-[#927E85]">
                    Paiement enregistré le{" "}
                    {formatDateTime(
                      appointment.paidAt,
                    )}
                  </p>
                ) : null}
              </div>
            </section>

            <section className="rounded-[28px] border border-[#241A1D]/8 bg-white p-6 shadow-sm">
              <h2 className="font-serif text-2xl text-[#241A1D]">
                Actions
              </h2>

              <div className="mt-5 space-y-3">
                {canDownloadCalendar ? (
                  <a
                    href={`/api/appointments/${encodeURIComponent(
                      appointment.reference,
                    )}/calendar`}
                    className="flex w-full items-center justify-center gap-2 rounded-xl bg-[#241A1D] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#3A2A2F]"
                  >
                    <CalendarPlus className="size-4" />
                    Ajouter au calendrier
                  </a>
                ) : (
                  <div className="rounded-xl bg-[#F3EEEE] px-5 py-3 text-center text-sm font-semibold text-[#927E85]">
                    Calendrier disponible après
                    confirmation
                  </div>
                )}

                {(
                  appointment.status === "PENDING" ||
                  appointment.status === "CONFIRMED"
                ) &&
                appointment.startsAt > new Date() ? (
                  <CancelAppointmentButton
                    reference={appointment.reference}
                    startsAt={appointment.startsAt.toISOString()}
                    depositCents={appointment.depositCents}
                    paymentStatus={appointment.paymentStatus}
                  />
                ) : null}

                {!isInactive ? (
                  <Link
                    href="/contact"
                    className="flex w-full items-center justify-center gap-2 rounded-xl border border-[#241A1D]/15 bg-white px-5 py-3 text-sm font-semibold text-[#241A1D] transition hover:bg-[#FFF5F3]"
                  >
                    <MessageSquareText className="size-4" />
                    Contacter le salon
                  </Link>
                ) : null}

                <Link
                  href="/reservation"
                  className="flex w-full items-center justify-center gap-2 rounded-xl border border-[#241A1D]/15 bg-white px-5 py-3 text-sm font-semibold text-[#241A1D] transition hover:bg-[#FFF5F3]"
                >
                  <CalendarDays className="size-4" />
                  Nouveau rendez-vous
                </Link>
              </div>
            </section>

            <section className="rounded-[28px] bg-[#241A1D] p-6 text-white shadow-sm">
              <div className="flex items-center gap-3">
                <MapPin className="size-5 text-[#E8B4B8]" />

                <h2 className="font-serif text-2xl">
                  Le salon
                </h2>
              </div>

              <p className="mt-5 font-semibold">
                {SALON_NAME}
              </p>

              <p className="mt-2 text-sm leading-6 text-white/65">
                {SALON_ADDRESS}
              </p>

              {appointment.workstation ? (
                <p className="mt-3 text-sm text-white/65">
                  Poste :{" "}
                  <strong className="text-white">
                    {appointment.workstation.name}
                  </strong>
                </p>
              ) : null}

              <div className="mt-6 space-y-3 border-t border-white/10 pt-5">
                <a
                  href={`tel:${SALON_PHONE.replace(
                    /\s/g,
                    "",
                  )}`}
                  className="flex items-center gap-3 text-sm text-white/75 transition hover:text-white"
                >
                  <Phone className="size-4 text-[#E8B4B8]" />
                  {SALON_PHONE}
                </a>

                <a
                  href={`mailto:${SALON_EMAIL}`}
                  className="flex items-center gap-3 break-all text-sm text-white/75 transition hover:text-white"
                >
                  <Mail className="size-4 shrink-0 text-[#E8B4B8]" />
                  {SALON_EMAIL}
                </a>
              </div>

              <a
                href={mapsUrl}
                target="_blank"
                rel="noreferrer"
                className="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-[#241A1D] transition hover:bg-[#FFF5F3]"
              >
                <MapPin className="size-4" />
                Ouvrir dans Maps
              </a>
            </section>

            <section className="rounded-[24px] border border-amber-200 bg-amber-50 p-5">
              <div className="flex gap-3">
                <AlertCircle className="mt-0.5 size-5 shrink-0 text-amber-700" />

                <div>
                  <h3 className="font-semibold text-amber-900">
                    Politique d’annulation
                  </h3>

                  <p className="mt-2 text-sm leading-6 text-amber-800">
                    Toute annulation effectuée moins de
                    48 heures avant le rendez-vous
                    entraîne la perte de la somme déjà
                    versée.
                  </p>
                </div>
              </div>
            </section>

            <section className="rounded-[24px] border border-[#241A1D]/8 bg-white p-5 text-xs leading-6 text-[#927E85]">
              <p>
                Réservation créée le{" "}
                {formatDateTime(
                  appointment.createdAt,
                )}
              </p>

              {appointment.confirmedAt ? (
                <p>
                  Confirmée le{" "}
                  {formatDateTime(
                    appointment.confirmedAt,
                  )}
                </p>
              ) : null}

              {appointment.completedAt ? (
                <p>
                  Terminée le{" "}
                  {formatDateTime(
                    appointment.completedAt,
                  )}
                </p>
              ) : null}

              {appointment.cancelledAt ? (
                <p>
                  Annulée le{" "}
                  {formatDateTime(
                    appointment.cancelledAt,
                  )}
                </p>
              ) : null}
            </section>
          </aside>
        </div>
      </div>
    </main>
  );
}
