import Link from "next/link";
import {
  Bell,
  CalendarDays,
  Home,
  UserRound,
} from "lucide-react";

import {
  ensureClientLoyaltyAccount,
} from "@/features/vip/services/ensure-client-loyalty-account.service";

import { prisma } from "@/lib/prisma";
import { requireClientUser } from "@/lib/session";

export const dynamic = "force-dynamic";

type ClientSpaceLayoutProps = {
  children: React.ReactNode;
};

export default async function ClientSpaceLayout({
  children,
}: ClientSpaceLayoutProps) {
  const user = await requireClientUser();

  await ensureClientLoyaltyAccount(
    user.id,
  );

  const unreadCount = await prisma.notification.count({
    where: {
      userId: user.id,
      readAt: null,
    },
  });

  const navigation = [
    {
      label: "Accueil",
      href: "/espace-client",
      icon: Home,
    },
    {
      label: "Rendez-vous",
      href: "/espace-client/rendez-vous",
      icon: CalendarDays,
    },
    {
      label: "Notifications",
      href: "/espace-client/notifications",
      icon: Bell,
      badge: unreadCount,
    },
  ];

  return (
    <div className="min-h-screen bg-[#FFF9F8]">
      <div className="sticky top-0 z-40 border-b border-[#241A1D]/8 bg-white/95 shadow-sm backdrop-blur">
        <div className="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
          <Link
            href="/espace-client"
            className="flex min-w-0 items-center gap-3"
          >
            <span className="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-[#241A1D] text-white">
              <UserRound className="size-5" />
            </span>

            <span className="hidden min-w-0 sm:block">
              <span className="block truncate text-sm font-semibold text-[#241A1D]">
                {user.firstName} {user.lastName}
              </span>
              <span className="block text-xs text-[#927E85]">
                Espace cliente
              </span>
            </span>
          </Link>

          <nav
            aria-label="Navigation de l’espace cliente"
            className="flex items-center gap-1 rounded-2xl border border-[#241A1D]/8 bg-[#FFF9F8] p-1"
          >
            {navigation.map((item) => {
              const Icon = item.icon;

              return (
                <Link
                  key={item.href}
                  href={item.href}
                  className="relative flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold text-[#75636A] transition hover:bg-white hover:text-[#241A1D] sm:px-4"
                >
                  <Icon className="size-4" />

                  <span className="hidden md:inline">
                    {item.label}
                  </span>

                  {item.badge && item.badge > 0 ? (
                    <span className="absolute -right-1 -top-1 flex min-w-5 items-center justify-center rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white ring-2 ring-white">
                      {item.badge > 99 ? "99+" : item.badge}
                    </span>
                  ) : null}
                </Link>
              );
            })}
          </nav>
        </div>
      </div>

      {children}
    </div>
  );
}
