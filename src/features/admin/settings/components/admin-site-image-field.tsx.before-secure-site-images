"use client";

import {
  useCallback,
} from "react";

import {
  ImageIcon,
  LoaderCircle,
  RefreshCcw,
  Trash2,
  UploadCloud,
} from "lucide-react";

import Image from "next/image";

import {
  useDropzone,
} from "react-dropzone";

import {
  toast,
} from "sonner";

import {
  useUploadThing,
} from "@/lib/uploadthing";

/* -------------------------------------------------------------------------- */
/*                                   TYPES                                    */
/* -------------------------------------------------------------------------- */

type AdminSiteImageFieldProps = {
  label: string;

  description?: string;

  value: string;

  onChange: (
    value: string,
  ) => void;

  name: string;

  errors:
    Record<
      string,
      string[]
    >;

  format?:
    | "SQUARE"
    | "WIDE"
    | "PORTRAIT";

  recommendedSize?: string;

  disabled?: boolean;
};

/* -------------------------------------------------------------------------- */
/*                              CONFIGURATION                                 */
/* -------------------------------------------------------------------------- */

const ACCEPTED_IMAGE_TYPES = {
  "image/jpeg": [],
  "image/png": [],
  "image/webp": [],
};

const PREVIEW_FORMAT_CLASSES = {
  SQUARE:
    "aspect-square",

  WIDE:
    "aspect-[16/9]",

  PORTRAIT:
    "aspect-[4/5]",
} satisfies Record<
  NonNullable<
    AdminSiteImageFieldProps["format"]
  >,
  string
>;

/* -------------------------------------------------------------------------- */
/*                                  COMPOSANT                                 */
/* -------------------------------------------------------------------------- */

export function AdminSiteImageField({
  label,
  description,
  value,
  onChange,
  name,
  errors,
  format = "WIDE",
  recommendedSize,
  disabled = false,
}: AdminSiteImageFieldProps) {
  const {
    startUpload,
    isUploading,
  } =
    useUploadThing(
      "siteSettingsUploader",
    );

  const hasError =
    Boolean(
      errors[name]?.length,
    );

  const handleUpload =
    useCallback(
      async (
        files: File[],
      ) => {
        const [
          file,
        ] =
          files;

        if (
          !file ||
          disabled ||
          isUploading
        ) {
          return;
        }

        try {
          const response =
            await startUpload([
              file,
            ]);

          const uploadedFile =
            response?.[0];

          if (
            !uploadedFile
          ) {
            toast.error(
              "L’image n’a pas pu être envoyée.",
            );

            return;
          }

          onChange(
            uploadedFile.ufsUrl,
          );

          toast.success(
            "L’image a bien été envoyée.",
          );
        } catch (
          error: unknown
        ) {
          console.error(
            "[ADMIN_SITE_IMAGE_UPLOAD]",
            error,
          );

          toast.error(
            "Une erreur est survenue pendant l’envoi de l’image.",
          );
        }
      },
      [
        disabled,
        isUploading,
        onChange,
        startUpload,
      ],
    );

  const {
    getRootProps,
    getInputProps,
    isDragActive,
  } =
    useDropzone({
      accept:
        ACCEPTED_IMAGE_TYPES,

      multiple:
        false,

      maxFiles:
        1,

      maxSize:
        8 *
        1024 *
        1024,

      disabled:
        disabled ||
        isUploading,

      onDrop:
        handleUpload,

      onDropRejected:
        (
          rejectedFiles,
        ) => {
          const rejection =
            rejectedFiles[0];

          if (
            rejection?.errors.some(
              (
                error,
              ) =>
                error.code ===
                "file-too-large",
            )
          ) {
            toast.error(
              "L’image dépasse la taille maximale de 8 Mo.",
            );

            return;
          }

          toast.error(
            "Format non accepté. Utilisez une image JPG, PNG ou WEBP.",
          );
        },
    });

  return (
    <div className="space-y-3">
      <div>
        <p className="text-sm font-bold text-zinc-800">
          {label}
        </p>

        {description ? (
          <p className="mt-1 text-xs leading-5 text-zinc-500">
            {description}
          </p>
        ) : null}
      </div>

      {value ? (
        <div
          className={[
            "group relative overflow-hidden rounded-2xl border bg-zinc-100",
            hasError
              ? "border-red-300"
              : "border-zinc-200",
            PREVIEW_FORMAT_CLASSES[
              format
            ],
          ].join(
            " ",
          )}
        >
          <Image
            src={
              value
            }
            alt={
              label
            }
            fill
            sizes={
              format ===
              "SQUARE"
                ? "(max-width: 768px) 100vw, 320px"
                : "(max-width: 768px) 100vw, 640px"
            }
            className="object-cover"
          />

          <div className="absolute inset-0 flex items-center justify-center gap-3 bg-zinc-950/55 opacity-0 backdrop-blur-sm transition group-hover:opacity-100 group-focus-within:opacity-100">
            <button
              {...getRootProps()}
              type="button"
              disabled={
                disabled ||
                isUploading
              }
              className="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-white px-5 text-sm font-bold text-zinc-900 shadow-lg transition hover:bg-rose-50 disabled:cursor-not-allowed disabled:opacity-60"
            >
              <input
                {...getInputProps()}
              />

              {isUploading ? (
                <LoaderCircle className="size-4 animate-spin" />
              ) : (
                <RefreshCcw className="size-4" />
              )}

              Remplacer
            </button>

            <button
              type="button"
              disabled={
                disabled ||
                isUploading
              }
              onClick={() =>
                onChange(
                  "",
                )
              }
              className="inline-flex size-11 items-center justify-center rounded-full bg-white text-red-600 shadow-lg transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-60"
              aria-label={`Supprimer ${label.toLocaleLowerCase(
                "fr-FR",
              )}`}
            >
              <Trash2 className="size-4" />
            </button>
          </div>

          {isUploading ? (
            <div className="absolute inset-0 grid place-items-center bg-white/75 backdrop-blur-sm">
              <div className="flex items-center gap-3 rounded-full bg-white px-5 py-3 text-sm font-bold text-[#843F59] shadow-lg">
                <LoaderCircle className="size-5 animate-spin" />

                Envoi en cours…
              </div>
            </div>
          ) : null}
        </div>
      ) : (
        <div
          {...getRootProps()}
          className={[
            "flex cursor-pointer flex-col items-center justify-center rounded-2xl border border-dashed px-6 text-center outline-none transition",
            PREVIEW_FORMAT_CLASSES[
              format
            ],
            disabled ||
            isUploading
              ? "cursor-not-allowed bg-zinc-50 opacity-60"
              : isDragActive
                ? "border-[#B45F7A] bg-[#FFF0F4] ring-4 ring-[#B45F7A]/10"
                : "border-[#E8B4C0] bg-[#FFF8FA] hover:border-[#B45F7A] hover:bg-[#FFF0F4]",
            hasError
              ? "border-red-300 bg-red-50"
              : "",
          ].join(
            " ",
          )}
        >
          <input
            {...getInputProps()}
          />

          <span className="grid size-14 place-items-center rounded-2xl bg-white text-[#B45F7A] shadow-sm">
            {isUploading ? (
              <LoaderCircle className="size-6 animate-spin" />
            ) : isDragActive ? (
              <ImageIcon className="size-6" />
            ) : (
              <UploadCloud className="size-6" />
            )}
          </span>

          <p className="mt-4 text-sm font-bold text-[#2F2027]">
            {isUploading
              ? "Envoi de l’image…"
              : isDragActive
                ? "Déposez l’image ici"
                : "Choisir une image"}
          </p>

          <p className="mt-2 max-w-sm text-xs leading-5 text-[#816D75]">
            JPG, PNG ou WEBP, jusqu’à 8 Mo.
            {recommendedSize
              ? ` Format conseillé : ${recommendedSize}.`
              : ""}
          </p>
        </div>
      )}

      {errors[name]?.map(
        (
          error,
        ) => (
          <p
            key={
              error
            }
            className="text-xs font-medium text-red-600"
          >
            {error}
          </p>
        ),
      )}
    </div>
  );
}
