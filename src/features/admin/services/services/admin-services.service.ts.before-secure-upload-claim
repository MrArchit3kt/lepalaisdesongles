async function assertCategoryExists(
  categoryId: string,
): Promise<void> {
  const category =
    await prisma.serviceCategory.findUnique({
      where: {
        id:
          categoryId,
      },

      select: {
        id:
          true,
      },
    });

  if (!category) {
    throw new AdminServiceValidationError(
      "La catégorie sélectionnée est introuvable.",
      {
        categoryId: [
          "Sélectionnez une catégorie valide.",
        ],
      },
    );
  }
}

