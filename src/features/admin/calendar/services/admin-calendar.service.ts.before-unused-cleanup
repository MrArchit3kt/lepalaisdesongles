      }),
    ]);

  return {
    workingHours,
    overrides,
    timeOffs,
  };
}

function findStaffOverrideForDate(
  staff: CalendarStaffRecord,
  date: Date,
) {
  const dateKey = startOfUtcDay(date).getTime();

  return staff.overrides.find(
    (override) =>
      startOfUtcDay(override.date).getTime() === dateKey,
  );
}

function findStaffWorkingHourForDate(
  staff: CalendarStaffRecord,
  date: Date,
) {
  const dayOfWeek = getDayOfWeek(date);

  return staff.workingHours.find(
    (workingHour) => workingHour.dayOfWeek === dayOfWeek,
  );
}

function findBusinessOverrideForDate(
  businessData: CalendarBusinessData,
