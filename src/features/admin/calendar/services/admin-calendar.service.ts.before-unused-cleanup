function filterAppointmentsBySearch(
  appointments: CalendarAppointmentRecord[],
  rawSearch: string | null | undefined,
): CalendarAppointmentRecord[] {
  const search = normalizeSearch(rawSearch);

  if (!search) {
    return appointments;
  }

  return appointments.filter((appointment) => {
    const clientName = formatPersonName(appointment.client);
    const staffName = appointment.staff
      ? getStaffDisplayName(appointment.staff)
      : null;
    const workstationName =
      appointment.workstation?.name ?? null;

    return (
      containsNormalizedText(
        appointment.reference,
        search,
      ) ||
      containsNormalizedText(clientName, search) ||
      containsNormalizedText(
        appointment.client.email,
        search,
      ) ||
      containsNormalizedText(
        appointment.client.phone,
        search,
      ) ||
      containsNormalizedText(staffName, search) ||
      containsNormalizedText(
        workstationName,
        search,
      ) ||
      appointment.services.some((service) =>
        containsNormalizedText(
          service.serviceName,
          search,
        ),
      )
    );
  });
}

function sortCalendarEvents(
  events: AdminCalendarEvent[],
): AdminCalendarEvent[] {
  return [...events].sort((first, second) => {
    const startDifference =
      new Date(first.startsAt).getTime() -
      new Date(second.startsAt).getTime();

    if (startDifference !== 0) {
      return startDifference;
    }

    if (first.allDay !== second.allDay) {
      return first.allDay ? -1 : 1;
    }

    return first.title.localeCompare(
      second.title,
      "fr-FR",
    );
  });
}

function calculateCalendarStatistics(
  appointments: CalendarAppointmentRecord[],
): AdminCalendarPayload["statistics"] {
  let pendingAppointments = 0;
  let confirmedAppointments = 0;
  let inProgressAppointments = 0;
  let completedAppointments = 0;
  let cancelledAppointments = 0;
  let totalRevenueCents = 0;
  let totalBookedMinutes = 0;

  for (const appointment of appointments) {
    switch (appointment.status) {
      case AppointmentStatus.PENDING:
        pendingAppointments += 1;
        break;

      case AppointmentStatus.CONFIRMED:
        confirmedAppointments += 1;
        break;

      case AppointmentStatus.IN_PROGRESS:
        inProgressAppointments += 1;
        break;

      case AppointmentStatus.COMPLETED:
        completedAppointments += 1;
        totalRevenueCents += appointment.totalPriceCents;
        break;

      case AppointmentStatus.REFUSED:
      case AppointmentStatus.CANCELLED_BY_CLIENT:
      case AppointmentStatus.CANCELLED_BY_ADMIN:
      case AppointmentStatus.NO_SHOW:
      case AppointmentStatus.EXPIRED:
        cancelledAppointments += 1;
        break;
    }

    if (
      BLOCKING_STATUSES.includes(appointment.status) ||
      appointment.status === AppointmentStatus.COMPLETED
    ) {
      totalBookedMinutes += appointment.totalDurationMinutes;
    }
  }

  return {
    totalAppointments: appointments.length,
    pendingAppointments,
    confirmedAppointments,
    inProgressAppointments,
    completedAppointments,
    cancelledAppointments,
    totalRevenueCents,
    totalBookedMinutes,
  };
}

function calculateBusinessHours(
  businessData: CalendarBusinessData,
): AdminCalendarPayload["businessHours"] {
  const startTimes = businessData.workingHours
    .filter(
      (workingHour) =>
        workingHour.isOpen &&
        isValidTimeString(workingHour.startTime),
    )
    .map((workingHour) => workingHour.startTime as string)
    .sort();

  const endTimes = businessData.workingHours
    .filter(
      (workingHour) =>
        workingHour.isOpen &&
        isValidTimeString(workingHour.endTime),
    )
    .map((workingHour) => workingHour.endTime as string)
    .sort();

  return {
    dayStart: startTimes[0] ?? DEFAULT_DAY_START,
    dayEnd:
      endTimes[endTimes.length - 1] ??
      DEFAULT_DAY_END,
    slotIntervalMinutes:
      DEFAULT_SLOT_INTERVAL_MINUTES,
  };
}

export async function getAdminCalendar(
  input: GetAdminCalendarInput,
): Promise<AdminCalendarPayload> {
  await assertCalendarActor(input.actorId);

  const range = normalizeCalendarRange({
    startsAt: input.startsAt,
    endsAt: input.endsAt,
  });

  const [
    rawAppointments,
    staffRecords,
    workstations,
    businessData,
  ] = await Promise.all([
    loadCalendarAppointments({
      range,
      staffId: input.staffId,
      workstationId: input.workstationId,
      statuses: input.statuses,
    }),
    loadCalendarStaff({
      range,
      staffId: input.staffId,
    }),
    loadCalendarWorkstations({
      workstationId: input.workstationId,
    }),
    loadCalendarBusinessData(range),
  ]);

  const appointments = filterAppointmentsBySearch(
    rawAppointments,
    input.search,
  );

  const appointmentEvents =
    appointments.map(mapAppointmentEvent);

  const staffScheduleEvents =
    buildStaffScheduleEvents({
      staff: staffRecords,
      range,
    });

  const businessScheduleEvents =
    buildBusinessScheduleEvents({
      businessData,
      range,
    });

  const events = sortCalendarEvents([
    ...appointmentEvents,
    ...staffScheduleEvents,
    ...businessScheduleEvents,
  ]);

  return {
    range: {
      startsAt: range.startsAtIso,
      endsAt: range.endsAtIso,
      numberOfDays: range.numberOfDays,
      timeZone: CALENDAR_TIME_ZONE,
    },

    staff: staffRecords.map(mapStaffResource),
    workstations,

    events,
    appointments:
      appointments.map(mapLegacyAppointment),

    businessHours:
      calculateBusinessHours(businessData),

    statistics:
      calculateCalendarStatistics(appointments),
  };
}

/* -------------------------------------------------------------------------- */
/*                           MOVE APPOINTMENT                                  */
/* -------------------------------------------------------------------------- */

export async function moveCalendarAppointment(input: {
  reference: string;
  actorId: string;
  startsAt: string;
  endsAt: string;
  staffId?: string | null;
  workstationId?: string | null;
}) {
  await assertCalendarActor(input.actorId);

  const reference = input.reference.trim();

  if (!reference) {
    throw new Error("La référence du rendez-vous est obligatoire.");
  }

  const startsAt = new Date(input.startsAt);
  const endsAt = new Date(input.endsAt);

  if (
    Number.isNaN(startsAt.getTime()) ||
    Number.isNaN(endsAt.getTime())
  ) {
    throw new Error("Les dates du rendez-vous sont invalides.");
  }

  if (endsAt <= startsAt) {
    throw new Error(
      "La date de fin doit être postérieure à la date de début.",
    );
  }

  const appointment =
    await prisma.appointment.findUnique({
      where: {
        reference,
      },
      select: {
        id: true,
        reference: true,
        status: true,
        staffId: true,
        workstationId: true,
      },
    });

  if (!appointment) {
    throw new Error("Rendez-vous introuvable.");
  }

  const movableStatuses = [
    "PENDING",
    "CONFIRMED",
  ] as const;

  if (
    !movableStatuses.includes(
      appointment.status as (typeof movableStatuses)[number],
    )
  ) {
    throw new Error(
      "Ce rendez-vous ne peut plus être déplacé.",
    );
  }

  const staffId =
    input.staffId === undefined
      ? appointment.staffId
      : input.staffId;

  const workstationId =
    input.workstationId === undefined
      ? appointment.workstationId
      : input.workstationId;

  if (staffId) {
    const staff = await prisma.staffProfile.findFirst({
      where: {
        id: staffId,
        isActive: true,
      },
      select: {
        id: true,
      },
    });

    if (!staff) {
      throw new Error(
        "L'employée sélectionnée est introuvable ou inactive.",
      );
    }
  }

  if (workstationId) {
    const workstation =
      await prisma.workstation.findFirst({
        where: {
          id: workstationId,
          isActive: true,
        },
        select: {
          id: true,
        },
      });

    if (!workstation) {
      throw new Error(
        "Le poste sélectionné est introuvable ou inactif.",
      );
    }
  }

  const conflictConditions = [];

  if (staffId) {
    conflictConditions.push({
      staffId,
    });
  }

  if (workstationId) {
    conflictConditions.push({
      workstationId,
    });
  }

  await validateCalendarMove({
    startsAt,
    endsAt,
    staffId,
  });

  if (conflictConditions.length > 0) {
    const conflict =
      await prisma.appointment.findFirst({
        where: {
          id: {
            not: appointment.id,
          },
          status: {
            in: [
              "PENDING",
              "CONFIRMED",
              "IN_PROGRESS",
            ],
          },
          startsAt: {
            lt: endsAt,
          },
          endsAt: {
            gt: startsAt,
          },
          OR: conflictConditions,
        },
        select: {
          reference: true,
          startsAt: true,
          endsAt: true,
          staffId: true,
          workstationId: true,
        },
      });

    if (conflict) {
      if (
        staffId &&
        conflict.staffId === staffId
      ) {
        throw new Error(
          "Cette employée possède déjà un rendez-vous sur ce créneau.",
        );
      }

      if (
        workstationId &&
        conflict.workstationId === workstationId
      ) {
        throw new Error(
          "Ce poste est déjà utilisé sur ce créneau.",
        );
      }

      throw new Error(
        "Ce créneau est déjà occupé.",
      );
    }
  }

  return prisma.appointment.update({
    where: {
      id: appointment.id,
    },
    data: {
      startsAt,
      endsAt,
      staffId,
      workstationId,
      totalDurationMinutes: Math.ceil(
        (endsAt.getTime() - startsAt.getTime()) /
          60_000,
      ),
      processedById: input.actorId,
    },
  });
}
