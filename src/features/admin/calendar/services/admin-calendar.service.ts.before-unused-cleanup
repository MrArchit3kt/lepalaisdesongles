function mapAppointmentEvent(
  appointment: CalendarAppointmentRecord,
): AdminCalendarEvent {
  const client = mapCalendarClient(appointment);
  const services = appointment.services.map(mapCalendarService);
  const images =appointment.images.map(mapCalendarImage);
  const serviceNames = services.map((service) => service.name);
  const color = getAppointmentColor(appointment);
  const editable = isAppointmentEditable(appointment.status);

  return {
    id: appointment.id,
    key: createEventKey(
      "APPOINTMENT",
      appointment.id,
      appointment.startsAt,
    ),
    kind: "APPOINTMENT",
    source: "APPOINTMENT",

    title: client.fullName,
    subtitle:
      serviceNames.length > 0
        ? serviceNames.join(", ")
        : "Rendez-vous",
    description: appointment.clientComment,

    startsAt: appointment.startsAt.toISOString(),
    endsAt: appointment.endsAt.toISOString(),
    allDay: false,

    color,
    textColor: "#ffffff",
    backgroundColor: hexToRgba(color, 0.18),
    borderColor: color,

    staffId: appointment.staffId,
    workstationId: appointment.workstationId,
    reference: appointment.reference,
    status: appointment.status,
    statusLabel: getAppointmentStatusLabel(appointment.status),

    draggable: editable,
    resizable: editable,
    blocking: BLOCKING_STATUSES.includes(appointment.status),
    editable,

    client,
    services,
    images,

    totalDurationMinutes: appointment.totalDurationMinutes,
    totalPriceCents: appointment.totalPriceCents,
    depositCents: appointment.depositCents,

    clientComment: appointment.clientComment,
    adminComment: appointment.adminComment,
    cancellationReason: appointment.cancellationReason,

    metadata: {
      paymentStatus: appointment.paymentStatus,
      paymentMethod: appointment.paymentMethod,
      staffName: appointment.staff
        ? getStaffDisplayName(appointment.staff)
        : null,
      staffColor: appointment.staff?.color ?? null,
      workstationName: appointment.workstation?.name ?? null,
      workstationSlug: appointment.workstation?.slug ?? null,
      createdAt: appointment.createdAt.toISOString(),
      updatedAt: appointment.updatedAt.toISOString(),
      confirmedAt: appointment.confirmedAt?.toISOString() ?? null,
      cancelledAt: appointment.cancelledAt?.toISOString() ?? null,
      completedAt: appointment.completedAt?.toISOString() ?? null,
    },
  };
}

