function buildStaffScheduleEvents(input: {
  staff: CalendarStaffRecord[];
  range: CalendarRange;
}): AdminCalendarEvent[] {
  const events: AdminCalendarEvent[] = [];

  for (const staff of input.staff) {
    for (
      let cursor = startOfUtcDay(input.range.startsAt);
      cursor <= input.range.endsAt;
      cursor = addUtcDays(cursor, 1)
    ) {
      const date = new Date(cursor);
      const override = findStaffOverrideForDate(staff, date);
      const regularWorkingHour =
        findStaffWorkingHourForDate(staff, date);

      if (override) {
        if (!override.isOpen) {
          events.push(
            buildStaffClosedEvent({
              staff,
              date,
              source: "STAFF_WORKING_HOUR_OVERRIDE",
              reason: override.reason,
            }),
          );

          continue;
        }

        if (
          override.hasBreak &&
          isValidTimeString(override.breakStart) &&
          isValidTimeString(override.breakEnd)
        ) {
          const startsAt = combineDateAndTime(
            date,
            override.breakStart,
          );
          const endsAt = combineDateAndTime(
            date,
            override.breakEnd,
          );

          if (endsAt > startsAt) {
            events.push(
              buildStaffBreakEvent({
                staff,
                date,
                startsAt,
                endsAt,
                source: "STAFF_WORKING_HOUR_OVERRIDE",
                label: override.reason,
              }),
            );
          }
        }

        continue;
      }

      if (!regularWorkingHour?.isOpen) {
        events.push(
          buildStaffClosedEvent({
            staff,
            date,
            source: "STAFF_WORKING_HOUR",
          }),
        );

        continue;
      }

      if (
        regularWorkingHour.hasBreak &&
        isValidTimeString(regularWorkingHour.breakStart) &&
        isValidTimeString(regularWorkingHour.breakEnd)
      ) {
        const startsAt = combineDateAndTime(
          date,
          regularWorkingHour.breakStart,
        );
        const endsAt = combineDateAndTime(
          date,
          regularWorkingHour.breakEnd,
        );

        if (endsAt > startsAt) {
          events.push(
            buildStaffBreakEvent({
              staff,
              date,
              startsAt,
              endsAt,
              source: "STAFF_WORKING_HOUR",
            }),
          );
        }
      }
    }

    for (const timeOff of staff.timeOffs) {
      const event = buildStaffTimeOffEvent({
        staff,
        timeOff,
        range: input.range,
      });

      if (event) {
        events.push(event);
      }
    }
  }

  return events;
}

function buildBusinessScheduleEvents(input: {
  businessData: CalendarBusinessData;
  range: CalendarRange;
}): AdminCalendarEvent[] {
  const events: AdminCalendarEvent[] = [];

  for (
    let cursor = startOfUtcDay(input.range.startsAt);
