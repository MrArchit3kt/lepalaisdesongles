function parseDate(value: string | Date | null | undefined): Date | null {
  if (!value) {
    return null;
  }

  const date = value instanceof Date ? new Date(value) : new Date(value);

  return Number.isNaN(date.getTime()) ? null : date;
}

function startOfUtcDay(date: Date): Date {
  const result = new Date(date);

  result.setUTCHours(0, 0, 0, 0);

  return result;
}

function endOfUtcDay(date: Date): Date {
  const result = new Date(date);

  result.setUTCHours(23, 59, 59, 999);

  return result;
}

function addUtcDays(date: Date, amount: number): Date {
  const result = new Date(date);

  result.setUTCDate(result.getUTCDate() + amount);

  return result;
}

function differenceInCalendarDays(startsAt: Date, endsAt: Date): number {
  const start = startOfUtcDay(startsAt).getTime();
  const end = startOfUtcDay(endsAt).getTime();

  return Math.floor((end - start) / 86_400_000);
}

function clamp(value: number, minimum: number, maximum: number): number {
  return Math.min(Math.max(value, minimum), maximum);
}

function normalizeCalendarRange(input: {
  startsAt?: string | Date | null;
  endsAt?: string | Date | null;
}): CalendarRange {
  const now = new Date();

  const parsedStart = parseDate(input.startsAt);
  const parsedEnd = parseDate(input.endsAt);

  const startsAt = startOfUtcDay(parsedStart ?? now);

  const requestedEnd =
    parsedEnd ??
    addUtcDays(startsAt, DEFAULT_RANGE_DAYS - 1);

  let endsAt = endOfUtcDay(requestedEnd);

  if (endsAt <= startsAt) {
    endsAt = endOfUtcDay(
      addUtcDays(startsAt, DEFAULT_RANGE_DAYS - 1),
    );
  }

  const requestedDays =
    differenceInCalendarDays(startsAt, endsAt) + 1;

  const numberOfDays = clamp(
    requestedDays,
    1,
    MAX_RANGE_DAYS,
  );

  const limitedEndsAt = endOfUtcDay(
    addUtcDays(startsAt, numberOfDays - 1),
  );

  return {
    startsAt,
    endsAt: limitedEndsAt,
    startsAtIso: startsAt.toISOString(),
    endsAtIso: limitedEndsAt.toISOString(),
    numberOfDays,
  };
}

function isValidTimeString(value: string | null | undefined): value is string {
  if (!value) {
    return false;
  }

  return /^([01]\d|2[0-3]):[0-5]\d$/.test(value);
}

function splitTime(value: string): {
  hours: number;
  minutes: number;
} {
  if (!isValidTimeString(value)) {
    throw new Error(`Heure invalide : ${value}`);
  }

  const [hours, minutes] = value
    .split(":")
    .map((part) => Number.parseInt(part, 10));

  return {
    hours,
    minutes,
  };
}

function combineDateAndTime(date: Date, time: string): Date {
  const { hours, minutes } = splitTime(time);

  const result = new Date(date);

  result.setUTCHours(hours, minutes, 0, 0);

  return result;
}

function getIsoDayNumber(date: Date): number {
  const nativeDay = date.getUTCDay();

  return nativeDay === 0 ? 7 : nativeDay;
}

function getDayOfWeek(date: Date): DayOfWeek {
  return DAY_OF_WEEK_BY_NUMBER[getIsoDayNumber(date)];
}

function formatPersonName(input: {
