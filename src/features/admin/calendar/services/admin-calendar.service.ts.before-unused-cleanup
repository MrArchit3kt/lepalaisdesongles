  };
}): string {
  const displayName = input.displayName?.trim();

  if (displayName) {
    return displayName;
  }

  return formatPersonName(input.user);
}

function normalizeHexColor(
  color: string | null | undefined,
  fallback: string,
): string {
  const value = color?.trim();

  if (!value) {
    return fallback;
  }

  if (/^#[0-9a-f]{6}$/i.test(value)) {
    return value;
  }

  if (/^#[0-9a-f]{3}$/i.test(value)) {
    const expanded = value
      .slice(1)
      .split("")
      .map((character) => character.repeat(2))
      .join("");

    return `#${expanded}`;
  }

  return fallback;
}

function hexToRgba(hex: string, alpha: number): string {
  const normalized = normalizeHexColor(hex, "#64748b");
  const value = normalized.slice(1);

  const red = Number.parseInt(value.slice(0, 2), 16);
  const green = Number.parseInt(value.slice(2, 4), 16);
  const blue = Number.parseInt(value.slice(4, 6), 16);

  return `rgba(${red}, ${green}, ${blue}, ${alpha})`;
}

function rangesOverlap(input: {
  firstStartsAt: Date;
  firstEndsAt: Date;
  secondStartsAt: Date;
  secondEndsAt: Date;
}): boolean {
  return (
    input.firstStartsAt < input.secondEndsAt &&
    input.firstEndsAt > input.secondStartsAt
  );
}

function clipRange(input: {
  startsAt: Date;
  endsAt: Date;
  minimum: Date;
  maximum: Date;
}): {
  startsAt: Date;
  endsAt: Date;
} | null {
  const startsAt =
    input.startsAt < input.minimum
      ? new Date(input.minimum)
      : new Date(input.startsAt);

  const endsAt =
    input.endsAt > input.maximum
      ? new Date(input.maximum)
      : new Date(input.endsAt);

  if (endsAt <= startsAt) {
    return null;
  }

  return {
    startsAt,
    endsAt,
  };
}

function getAppointmentStatusLabel(
  status: AppointmentStatus,
): string {
  return APPOINTMENT_STATUS_LABELS[status];
}

function getAppointmentColor(
  appointment: CalendarAppointmentRecord,
): string {
  const staffColor = normalizeHexColor(
    appointment.staff?.color,
    "",
  );

  if (staffColor) {
    return staffColor;
  }

  return APPOINTMENT_STATUS_COLORS[appointment.status];
}

function isAppointmentCancelled(
  status: AppointmentStatus,
): boolean {
  return (
    status === AppointmentStatus.CANCELLED_BY_CLIENT ||
    status === AppointmentStatus.CANCELLED_BY_ADMIN ||
    status === AppointmentStatus.REFUSED ||
    status === AppointmentStatus.EXPIRED
  );
}

function isAppointmentEditable(
  status: AppointmentStatus,
): boolean {
  return BLOCKING_STATUSES.includes(status);
}

function formatCalendarDate(date: Date): string {
  return new Intl.DateTimeFormat("fr-FR", {
    timeZone: CALENDAR_TIME_ZONE,
    dateStyle: "long",
    timeStyle: "short",
  }).format(date);
}

function createEventKey(
  kind: CalendarEventKind,
  id: string,
  startsAt: Date,
): string {
  return `${kind}:${id}:${startsAt.toISOString()}`;
}

function normalizeSearch(value: string | null | undefined): string {
  return value
    ?.trim()
    .toLocaleLowerCase("fr-FR")
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "") ?? "";
}

function containsNormalizedText(
  source: string | null | undefined,
  search: string,
): boolean {
  if (!search) {
    return true;
  }

  const normalizedSource = normalizeSearch(source);

  return normalizedSource.includes(search);
}

async function assertCalendarActor(actorId: string): Promise<{
  id: string;
}> {
  const actor = await prisma.user.findFirst({
    where: {
      id: actorId,
      role: {
        in: [...ACTIVE_ADMIN_ROLES],
      },
      status: "ACTIVE",
    },
    select: {
      id: true,
    },
  });

  if (!actor) {
    throw new Error("Accès administrateur refusé.");
  }

  return actor;
}
