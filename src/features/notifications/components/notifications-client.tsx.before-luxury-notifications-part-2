"use client";

import Link from "next/link";
import { useCallback, useEffect, useMemo, useState } from "react";
import {
  Bell,
  BellRing,
  CalendarCheck,
  CalendarClock,
  CalendarX,
  Check,
  CheckCheck,
  ChevronLeft,
  ChevronRight,
  Gift,
  Mail,
  MessageCircle,
  Megaphone,
  Star,
  Trash2,
  Trophy,
} from "lucide-react";

type NotificationKind =
  | "APPOINTMENT_CREATED"
  | "APPOINTMENT_CONFIRMED"
  | "APPOINTMENT_REFUSED"
  | "APPOINTMENT_CANCELLED"
  | "APPOINTMENT_REMINDER"
  | "MESSAGE_RECEIVED"
  | "REVIEW_RECEIVED"
  | "REVIEW_REQUEST"
  | "PROMOTION"
  | "CONTEST"
  | "SYSTEM";

type NotificationItem = {
  id: string;
  type: NotificationKind;
  title: string;
  message: string;
  actionUrl: string | null;
  metadata: unknown;
  readAt: string | null;
  createdAt: string;
  isRead: boolean;
};

type NotificationResponse = {
  items: NotificationItem[];
  total: number;
  unreadCount: number;
  page: number;
  pageSize: number;
  totalPages: number;
};

type Filter = "all" | "unread";

const TYPE_LABELS: Record<NotificationKind, string> = {
  APPOINTMENT_CREATED: "Réservation",
  APPOINTMENT_CONFIRMED: "Confirmation",
  APPOINTMENT_REFUSED: "Rendez-vous",
  APPOINTMENT_CANCELLED: "Annulation",
  APPOINTMENT_REMINDER: "Rappel",
  MESSAGE_RECEIVED: "Message",
  REVIEW_RECEIVED: "Avis",
  REVIEW_REQUEST: "Avis",
  PROMOTION: "Offre",
  CONTEST: "Concours",
  SYSTEM: "Information",
};

function NotificationIcon({ type }: { type: NotificationKind }) {
  const className = "h-5 w-5";

  switch (type) {
    case "APPOINTMENT_CREATED":
      return <CalendarClock className={className} />;
    case "APPOINTMENT_CONFIRMED":
      return <CalendarCheck className={className} />;
    case "APPOINTMENT_REFUSED":
    case "APPOINTMENT_CANCELLED":
      return <CalendarX className={className} />;
    case "APPOINTMENT_REMINDER":
      return <BellRing className={className} />;
    case "MESSAGE_RECEIVED":
      return <MessageCircle className={className} />;
    case "REVIEW_RECEIVED":
    case "REVIEW_REQUEST":
      return <Star className={className} />;
    case "PROMOTION":
      return <Gift className={className} />;
    case "CONTEST":
      return <Trophy className={className} />;
    case "SYSTEM":
      return <Megaphone className={className} />;
  }
}

function formatDate(value: string): string {
  return new Intl.DateTimeFormat("fr-FR", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(value));
}

async function readJson<T>(response: Response): Promise<T> {
  const payload = (await response.json().catch(() => null)) as
    | T
    | { message?: string }
    | null;

  if (!response.ok) {
    throw new Error(
      payload &&
        typeof payload === "object" &&
        "message" in payload &&
        typeof payload.message === "string"
        ? payload.message
        : "Une erreur est survenue.",
    );
  }

  return payload as T;
}

export function NotificationsClient() {
  const [data, setData] = useState<NotificationResponse | null>(null);
  const [filter, setFilter] = useState<Filter>("all");
  const [page, setPage] = useState(1);
  const [loading, setLoading] = useState(true);
  const [actionId, setActionId] = useState<string | null>(null);
  const [globalAction, setGlobalAction] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const loadNotifications = useCallback(async () => {
    setLoading(true);
    setError(null);

    try {
      const searchParams = new URLSearchParams({
        page: String(page),
        pageSize: "10",
      });

      if (filter === "unread") {
        searchParams.set("unreadOnly", "true");
      }

      const response = await fetch(
        `/api/notifications?${searchParams.toString()}`,
        { cache: "no-store" },
      );

      const payload = await readJson<NotificationResponse>(response);
      setData(payload);
    } catch (reason: unknown) {
      setError(
        reason instanceof Error
          ? reason.message
          : "Impossible de charger les notifications.",
      );
    } finally {
      setLoading(false);
    }
  }, [filter, page]);

  useEffect(() => {
    const timeoutId = window.setTimeout(() => {
      void loadNotifications();
    }, 0);

    return () => {
      window.clearTimeout(timeoutId);
    };
  }, [loadNotifications]);

  const hasReadNotifications = useMemo(
    () => data?.items.some((item) => item.isRead) ?? false,
    [data],
  );

  async function updateNotification(notification: NotificationItem) {
    setActionId(notification.id);
    setError(null);

    try {
      const response = await fetch(
        `/api/notifications/${notification.id}`,
        {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ isRead: !notification.isRead }),
        },
      );

      await readJson<{ success: true }>(response);
      await loadNotifications();
    } catch (reason: unknown) {
      setError(
        reason instanceof Error
          ? reason.message
          : "Impossible de mettre à jour la notification.",
      );
    } finally {
      setActionId(null);
    }
  }

  async function removeNotification(id: string) {
    setActionId(id);
    setError(null);

    try {
      const response = await fetch(`/api/notifications/${id}`, {
        method: "DELETE",
      });

      await readJson<{ success: true }>(response);

      if (data?.items.length === 1 && page > 1) {
        setPage((current) => current - 1);
      } else {
        await loadNotifications();
      }
    } catch (reason: unknown) {
      setError(
        reason instanceof Error
          ? reason.message
          : "Impossible de supprimer la notification.",
      );
    } finally {
      setActionId(null);
    }
  }

  async function markAllAsRead() {
    setGlobalAction(true);
    setError(null);

    try {
      const response = await fetch("/api/notifications/read-all", {
        method: "PATCH",
      });

      await readJson<{ success: true }>(response);
      await loadNotifications();
    } catch (reason: unknown) {
      setError(
        reason instanceof Error
          ? reason.message
          : "Impossible de tout marquer comme lu.",
      );
    } finally {
      setGlobalAction(false);
    }
  }

  async function deleteReadNotifications() {
    setGlobalAction(true);
    setError(null);

    try {
      const response = await fetch("/api/notifications/delete-read", {
        method: "DELETE",
      });

      await readJson<{ success: true }>(response);
      setPage(1);
      await loadNotifications();
    } catch (reason: unknown) {
      setError(
        reason instanceof Error
          ? reason.message
          : "Impossible de supprimer les notifications lues.",
      );
    } finally {
      setGlobalAction(false);
    }
  }

  function changeFilter(nextFilter: Filter) {
    setFilter(nextFilter);
    setPage(1);
  }

  return (
    <section className="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6 lg:py-12">
      <header className="relative overflow-hidden rounded-[2rem] border border-[#EFDEE4] bg-white/95 p-6 shadow-[0_20px_55px_rgba(85,38,55,0.09)] backdrop-blur sm:p-8">
        <div className="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
          <div className="flex items-start gap-4">
            <div className="rounded-2xl bg-gradient-to-br from-[#B45F7A] to-[#843F59] p-3 text-white shadow-[0_10px_25px_rgba(132,63,89,0.24)]">
              <Bell className="h-6 w-6" />
            </div>

            <div>
              <p className="text-[10px] font-black uppercase tracking-[0.2em] text-[#A5526D]">
                Espace client
              </p>
              <h1 className="mt-2 font-serif text-3xl font-semibold tracking-tight text-[#2F2027] sm:text-4xl">
                Mes notifications
              </h1>
              <p className="mt-3 max-w-2xl text-sm leading-7 text-[#816D75]">
                Retrouvez les confirmations, rappels et informations
                concernant vos rendez-vous.
              </p>
            </div>
          </div>

          <div className="flex flex-wrap gap-2">
            <button
              type="button"
              onClick={() => void markAllAsRead()}
              disabled={globalAction || !data || data.unreadCount === 0}
              className="inline-flex items-center gap-2 rounded-full border border-[#E8C3CF] bg-white px-4 py-2 text-sm font-black text-[#843F59] shadow-sm transition hover:border-[#D8AAB9] hover:bg-[#FFF0F4] disabled:cursor-not-allowed disabled:opacity-50"
            >
              <CheckCheck className="h-4 w-4" />
              Tout marquer comme lu
            </button>

            <button
              type="button"
              onClick={() => void deleteReadNotifications()}
              disabled={globalAction || !hasReadNotifications}
              className="inline-flex items-center gap-2 rounded-full border border-red-200 bg-white px-4 py-2 text-sm font-black text-red-700 shadow-sm transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50"
            >
              <Trash2 className="h-4 w-4" />
              Supprimer les lues
            </button>
          </div>
        </div>

        <div className="mt-6 flex flex-wrap items-center gap-3">
          <button
            type="button"
            onClick={() => changeFilter("all")}
            className={`rounded-full px-4 py-2 text-sm font-black transition ${
              filter === "all"
                ? "bg-gradient-to-r from-[#B45F7A] to-[#843F59] text-white shadow-[0_8px_20px_rgba(132,63,89,0.22)]"
                : "border border-[#EFDDE3] bg-[#FFF8FA] text-[#705D65] hover:border-[#DDBAC5] hover:bg-white hover:text-[#843F59]"
            }`}
          >
            Toutes{data ? ` (${data.total})` : ""}
          </button>

          <button
            type="button"
            onClick={() => changeFilter("unread")}
            className={`rounded-full px-4 py-2 text-sm font-black transition ${
              filter === "unread"
                ? "bg-gradient-to-r from-[#B45F7A] to-[#843F59] text-white shadow-[0_8px_20px_rgba(132,63,89,0.22)]"
                : "border border-[#EFDDE3] bg-[#FFF8FA] text-[#705D65] hover:border-[#DDBAC5] hover:bg-white hover:text-[#843F59]"
            }`}
          >
            Non lues{data ? ` (${data.unreadCount})` : ""}
          </button>
        </div>
      </header>

      {error ? (
        <div
          role="alert"
          className="rounded-[1.5rem] border border-red-200 bg-gradient-to-br from-red-50 to-white px-5 py-4 text-sm font-semibold text-red-800 shadow-[0_12px_30px_rgba(220,38,38,0.06)]"
        >
          {error}
        </div>
      ) : null}

      {loading ? (
        <div className="space-y-3" aria-label="Chargement">
          {Array.from({ length: 4 }).map((_, index) => (
            <div
              key={index}
              className="h-32 animate-pulse rounded-[1.75rem] border border-[#EFDEE4] bg-gradient-to-br from-white to-[#FFF4F7] shadow-[0_12px_30px_rgba(85,38,55,0.05)]"
            />
          ))}
        </div>
      ) : data && data.items.length > 0 ? (
        <div className="space-y-3">
          {data.items.map((notification) => (
            <article
              key={notification.id}
              className={`group rounded-[1.75rem] border p-5 shadow-[0_14px_36px_rgba(85,38,55,0.07)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_20px_46px_rgba(132,63,89,0.11)] ${
                notification.isRead
                  ? "border-[#EFDEE4] bg-white/95"
                  : "border-[#DDBAC5] bg-gradient-to-br from-white to-[#FFF1F5]"
              }`}
            >
              <div className="flex flex-col gap-5 sm:flex-row sm:items-start">
                <div className="flex min-w-0 flex-1 gap-4">
                  <div
                    className={`shrink-0 rounded-2xl p-3 ${
                      notification.isRead
                        ? "border border-[#E6D8DD] bg-[#F8F4F5] text-[#806C74]"
                        : "bg-gradient-to-br from-[#B45F7A] to-[#843F59] text-white shadow-[0_9px_22px_rgba(132,63,89,0.22)]"
                    }`}
                  >
                    <NotificationIcon type={notification.type} />
                  </div>

                  <div className="min-w-0 flex-1">
                    <div className="flex flex-wrap items-center gap-2">
                      <span className="text-[10px] font-black uppercase tracking-[0.16em] text-[#A68C96]">
                        {TYPE_LABELS[notification.type]}
                      </span>

                      {!notification.isRead ? (
                        <span className="rounded-full border border-[#E8C3CF] bg-[#FFF1F5] px-2.5 py-1 text-xs font-black text-[#A5526D]">
                          Nouveau
                        </span>
                      ) : null}
                    </div>

                    <h2 className="mt-2 font-serif text-lg font-semibold text-[#2F2027] sm:text-xl">
                      {notification.actionUrl ? (
                        <Link
                          href={notification.actionUrl}
                          className="outline-none transition hover:text-[#843F59] hover:underline focus-visible:ring-2 focus-visible:ring-[#B45F7A]"
                          onClick={() => {
                            if (!notification.isRead) {
                              void updateNotification(notification);
                            }
                          }}
                        >
                          {notification.title}
                        </Link>
                      ) : (
                        notification.title
                      )}
                    </h2>

                    <p className="mt-1 text-sm leading-6 text-neutral-600">
                      {notification.message}
                    </p>

                    <p className="mt-3 text-xs text-neutral-500">
                      {formatDate(notification.createdAt)}
                    </p>
                  </div>
                </div>

                <div className="flex shrink-0 items-center gap-2 sm:flex-col">
                  <button
                    type="button"
                    onClick={() => void updateNotification(notification)}
                    disabled={actionId === notification.id}
                    title={
                      notification.isRead
                        ? "Marquer comme non lue"
                        : "Marquer comme lue"
                    }
                    className="inline-flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 text-neutral-700 transition hover:bg-neutral-100 disabled:opacity-50"
                  >
                    {notification.isRead ? (
                      <Mail className="h-4 w-4" />
                    ) : (
                      <Check className="h-4 w-4" />
                    )}
                  </button>

                  <button
                    type="button"
                    onClick={() => void removeNotification(notification.id)}
                    disabled={actionId === notification.id}
                    title="Supprimer"
                    className="inline-flex h-10 w-10 items-center justify-center rounded-full border border-red-200 text-red-700 transition hover:bg-red-50 disabled:opacity-50"
                  >
                    <Trash2 className="h-4 w-4" />
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div className="rounded-3xl border border-dashed border-neutral-300 bg-white px-6 py-16 text-center">
          <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-neutral-100 text-neutral-600">
            <Bell className="h-6 w-6" />
          </div>

          <h2 className="mt-5 text-lg font-semibold text-neutral-950">
            Aucune notification
          </h2>

          <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-neutral-600">
            {filter === "unread"
              ? "Vous avez lu toutes vos notifications."
              : "Vos prochaines confirmations et informations apparaîtront ici."}
          </p>
        </div>
      )}

      {data && data.totalPages > 1 ? (
        <nav
          aria-label="Pagination des notifications"
          className="flex items-center justify-between rounded-2xl border border-neutral-200 bg-white p-3"
        >
          <button
            type="button"
            onClick={() =>
              setPage((current) => Math.max(1, current - 1))
            }
            disabled={page <= 1 || loading}
            className="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 disabled:opacity-40"
          >
            <ChevronLeft className="h-4 w-4" />
            Précédent
          </button>

          <span className="text-sm text-neutral-600">
            Page {data.page} sur {data.totalPages}
          </span>

          <button
            type="button"
            onClick={() =>
              setPage((current) =>
                Math.min(data.totalPages, current + 1),
              )
            }
            disabled={page >= data.totalPages || loading}
            className="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 disabled:opacity-40"
          >
            Suivant
            <ChevronRight className="h-4 w-4" />
          </button>
        </nav>
      ) : null}
    </section>
  );
}
