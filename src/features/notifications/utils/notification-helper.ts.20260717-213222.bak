import type {
  CreateNotificationInput,
  NotificationKind,
} from "../types/notification.types";

type AppointmentNotificationInput = {
  userId: string;
  reference: string;
  startsAt?: Date;
};

function formatAppointmentDate(
  value: Date | undefined,
): string | null {
  if (!value) {
    return null;
  }

  return new Intl.DateTimeFormat("fr-FR", {
    timeZone: "Europe/Paris",
    dateStyle: "long",
    timeStyle: "short",
  }).format(value);
}

function appointmentActionUrl(
  reference: string,
): string {
  return `/espace-client/rendez-vous/${encodeURIComponent(
    reference.trim(),
  )}`;
}

function buildAppointmentNotification(
  type: NotificationKind,
  title: string,
  message: string,
  input: AppointmentNotificationInput,
): CreateNotificationInput {
  return {
    userId: input.userId,
    type,
    title,
    message,
    actionUrl: appointmentActionUrl(
      input.reference,
    ),
    metadata: {
      appointmentReference:
        input.reference.trim(),
      ...(input.startsAt
        ? {
            startsAt:
              input.startsAt.toISOString(),
          }
        : {}),
    },
  };
}

export function appointmentCreatedNotification(
  input: AppointmentNotificationInput,
): CreateNotificationInput {
  const date = formatAppointmentDate(
    input.startsAt,
  );

  return buildAppointmentNotification(
    "APPOINTMENT_CREATED",
    "Réservation enregistrée",
    date
      ? `Votre demande de rendez-vous du ${date} a bien été enregistrée.`
      : "Votre demande de rendez-vous a bien été enregistrée.",
    input,
  );
}

export function appointmentConfirmedNotification(
  input: AppointmentNotificationInput,
): CreateNotificationInput {
  const date = formatAppointmentDate(
    input.startsAt,
  );

  return buildAppointmentNotification(
    "APPOINTMENT_CONFIRMED",
    "Rendez-vous confirmé",
    date
      ? `Votre rendez-vous du ${date} est confirmé.`
      : "Votre rendez-vous est confirmé.",
    input,
  );
}

export function appointmentRefusedNotification(
  input: AppointmentNotificationInput,
): CreateNotificationInput {
  return buildAppointmentNotification(
    "APPOINTMENT_REFUSED",
    "Rendez-vous refusé",
    "Votre demande de rendez-vous n’a pas pu être acceptée.",
    input,
  );
}

export function appointmentCancelledNotification(
  input: AppointmentNotificationInput,
): CreateNotificationInput {
  return buildAppointmentNotification(
    "APPOINTMENT_CANCELLED",
    "Rendez-vous annulé",
    "Votre rendez-vous a été annulé.",
    input,
  );
}

export function appointmentReminderNotification(
  input: AppointmentNotificationInput,
): CreateNotificationInput {
  const date = formatAppointmentDate(
    input.startsAt,
  );

  return buildAppointmentNotification(
    "APPOINTMENT_REMINDER",
    "Rappel de rendez-vous",
    date
      ? `Petit rappel : votre rendez-vous est prévu le ${date}.`
      : "Petit rappel : votre rendez-vous approche.",
    input,
  );
}

export function systemNotification(input: {
  userId: string;
  title: string;
  message: string;
  actionUrl?: string | null;
}): CreateNotificationInput {
  return {
    userId: input.userId,
    type: "SYSTEM",
    title: input.title,
    message: input.message,
    actionUrl: input.actionUrl,
  };
}
