"use client";

import {
  useCallback,
  useEffect,
  useRef,
  useState,
} from "react";

import type {
  NotificationKind,
  NotificationJsonValue,
} from "../types/notification.types";

/* -------------------------------------------------------------------------- */
/*                                   TYPES                                    */
/* -------------------------------------------------------------------------- */

export type AdminRealtimeNotification = {
  id: string;
  type: NotificationKind;
  title: string;
  message: string;
  actionUrl: string | null;
  metadata: NotificationJsonValue | null;
  readAt: string | null;
  createdAt: string;
  isRead: boolean;
};

type UseAdminNotificationsOptions = {
  enabled?: boolean;
  onNotification?: (
    notification: AdminRealtimeNotification,
  ) => void;
  onUnreadCountChange?: (
    unreadCount: number,
  ) => void;
  onConnectionChange?: (
    connected: boolean,
  ) => void;
};

type UseAdminNotificationsResult = {
  unreadCount: number;
  connected: boolean;
  reconnecting: boolean;
  lastNotification: AdminRealtimeNotification | null;
  reconnect: () => void;
};

/* -------------------------------------------------------------------------- */
/*                                CONFIGURATION                               */
/* -------------------------------------------------------------------------- */

const STREAM_URL =
  "/api/admin/notifications/stream";

const RECONNECT_DELAY_MS =
  3_000;

/* -------------------------------------------------------------------------- */
/*                                  HELPERS                                   */
/* -------------------------------------------------------------------------- */

function parseJson<T>(
  value: string,
): T | null {
  try {
    return JSON.parse(
      value,
    ) as T;
  } catch {
    return null;
  }
}

function normalizeUnreadCount(
  value: unknown,
): number {
  if (
    typeof value !==
      "number" ||
    !Number.isFinite(
      value,
    )
  ) {
    return 0;
  }

  return Math.max(
    0,
    Math.trunc(
      value,
    ),
  );
}

/* -------------------------------------------------------------------------- */
/*                                    HOOK                                    */
/* -------------------------------------------------------------------------- */

export function useAdminNotifications({
  enabled = true,
  onNotification,
  onUnreadCountChange,
  onConnectionChange,
}: UseAdminNotificationsOptions = {}): UseAdminNotificationsResult {
  const [
    unreadCount,
    setUnreadCount,
  ] = useState(0);

  const [
    connected,
    setConnected,
  ] = useState(false);

  const [
    reconnecting,
    setReconnecting,
  ] = useState(false);

  const [
    lastNotification,
    setLastNotification,
  ] =
    useState<AdminRealtimeNotification | null>(
      null,
    );

  const eventSourceRef =
    useRef<EventSource | null>(
      null,
    );

  const reconnectTimerRef =
    useRef<ReturnType<typeof setTimeout> | null>(
      null,
    );

  const mountedRef =
    useRef(false);

  const manuallyClosedRef =
    useRef(false);

  const onNotificationRef =
    useRef(onNotification);

  const onUnreadCountChangeRef =
    useRef(
      onUnreadCountChange,
    );

  const onConnectionChangeRef =
    useRef(
      onConnectionChange,
    );

  useEffect(() => {
    onNotificationRef.current =
      onNotification;
  }, [
    onNotification,
  ]);

  useEffect(() => {
    onUnreadCountChangeRef.current =
      onUnreadCountChange;
  }, [
    onUnreadCountChange,
  ]);

  useEffect(() => {
    onConnectionChangeRef.current =
      onConnectionChange;
  }, [
    onConnectionChange,
  ]);

  const clearReconnectTimer =
    useCallback(() => {
      if (
        reconnectTimerRef.current
      ) {
        clearTimeout(
          reconnectTimerRef.current,
        );

        reconnectTimerRef.current =
          null;
      }
    }, []);

  const closeEventSource =
    useCallback(() => {
      if (
        eventSourceRef.current
      ) {
        eventSourceRef.current.close();

        eventSourceRef.current =
          null;
      }
    }, []);

  const updateConnectionState =
    useCallback(
      (
        nextConnected: boolean,
      ) => {
        setConnected(
          nextConnected,
        );

        onConnectionChangeRef.current?.(
          nextConnected,
        );
      },
      [],
    );

  const connect =
    useCallback(() => {
      if (
        !enabled ||
        !mountedRef.current
      ) {
        return;
      }

      clearReconnectTimer();
      closeEventSource();

      manuallyClosedRef.current =
        false;

      setReconnecting(
        false,
      );

      const source =
        new EventSource(
          STREAM_URL,
          {
            withCredentials:
              true,
          },
        );

      eventSourceRef.current =
        source;

      source.addEventListener(
        "connected",
        () => {
          if (
            !mountedRef.current
          ) {
            return;
          }

          setReconnecting(
            false,
          );

          updateConnectionState(
            true,
          );
        },
      );

      source.addEventListener(
        "unread-count",
        (
          event: MessageEvent,
        ) => {
          if (
            !mountedRef.current
          ) {
            return;
          }

          const payload =
            parseJson<{
              unreadCount?: unknown;
            }>(
              event.data,
            );

          if (!payload) {
            return;
          }

          const nextUnreadCount =
            normalizeUnreadCount(
              payload.unreadCount,
            );

          setUnreadCount(
            nextUnreadCount,
          );

          onUnreadCountChangeRef.current?.(
            nextUnreadCount,
          );
        },
      );

      source.addEventListener(
        "notification",
        (
          event: MessageEvent,
        ) => {
          if (
            !mountedRef.current
          ) {
            return;
          }

          const notification =
            parseJson<AdminRealtimeNotification>(
              event.data,
            );

          if (
            !notification
          ) {
            return;
          }

          setLastNotification(
            notification,
          );

          onNotificationRef.current?.(
            notification,
          );
        },
      );

      source.addEventListener(
        "stream-error",
        (
          event: MessageEvent,
        ) => {
          const payload =
            parseJson<{
              message?: string;
            }>(
              event.data,
            );

          if (
            payload?.message
          ) {
            console.error(
              "[Admin notifications stream]",
              payload.message,
            );
          }
        },
      );

      source.onerror =
        () => {
          if (
            !mountedRef.current ||
            manuallyClosedRef.current
          ) {
            return;
          }

          updateConnectionState(
            false,
          );

          setReconnecting(
            true,
          );

          closeEventSource();
          clearReconnectTimer();

          reconnectTimerRef.current =
            setTimeout(
              () => {
                connect();
              },
              RECONNECT_DELAY_MS,
            );
        };
    }, [
      clearReconnectTimer,
      closeEventSource,
      enabled,
      updateConnectionState,
    ]);

  const reconnect =
    useCallback(() => {
      manuallyClosedRef.current =
        false;

      setReconnecting(
        true,
      );

      connect();
    }, [
      connect,
    ]);

  useEffect(() => {
    mountedRef.current =
      true;

    if (enabled) {
      connect();
    }

    return () => {
      mountedRef.current =
        false;

      manuallyClosedRef.current =
        true;

      clearReconnectTimer();
      closeEventSource();
    };
  }, [
    clearReconnectTimer,
    closeEventSource,
    connect,
    enabled,
  ]);

  useEffect(() => {
    if (!enabled) {
      manuallyClosedRef.current =
        true;

      clearReconnectTimer();
      closeEventSource();

      setConnected(
        false,
      );

      setReconnecting(
        false,
      );
    }
  }, [
    clearReconnectTimer,
    closeEventSource,
    enabled,
  ]);

  return {
    unreadCount,
    connected,
    reconnecting,
    lastNotification,
    reconnect,
  };
}
