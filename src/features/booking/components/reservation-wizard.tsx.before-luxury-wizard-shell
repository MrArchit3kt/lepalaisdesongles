"use client";

import {
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import {
  usePathname,
  useRouter,
} from "next/navigation";
import { Sparkles } from "lucide-react";

import type {
  AvailabilityResult,
  AvailabilitySlot,
} from "../types/availability.types";

import { ReservationCalendar } from "./reservation/reservation-calendar";
import { ReservationComment } from "./reservation/reservation-comment";
import { ReservationConfirm } from "./reservation/reservation-confirm";
import { ReservationPayment } from "./reservation/reservation-payment";
import { ReservationProgress } from "./reservation/reservation-progress";
import { ReservationServices } from "./reservation/reservation-services";
import { ReservationSlots } from "./reservation/reservation-slots";
import { ReservationStaff } from "./reservation/reservation-staff";
import { ReservationSummary } from "./reservation/reservation-summary";
import {
  ReservationUpload,
  type UploadedAppointmentImage,
} from "./reservation/reservation-upload";

import type {
  Category,
  ReservationStep,
  ReservationSummary as ReservationSummaryData,
  StaffMember,
} from "./reservation/reservation.types";

type ReservationWizardProps = {
  categories: Category[];
  staffMembers: StaffMember[];
};

type CreateAppointmentResponse = {
  message?: string;
  code?: string;
  confirmationUrl?: string;
};

function todayInParis(): string {
  return new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Paris",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(new Date());
}

function createSlotKey(
  slot: AvailabilitySlot,
): string {
  return [
    slot.startsAt,
    slot.endsAt,
    slot.staff.id,
    slot.workstation.id,
  ].join("-");
}

export function ReservationWizard({
  categories,
  staffMembers,
}: ReservationWizardProps) {
  const router = useRouter();
  const pathname = usePathname();

  const slotsSectionRef =
    useRef<HTMLDivElement | null>(null);

  const [serviceIds, setServiceIds] = useState<
    string[]
  >([]);

  const [staffId, setStaffId] =
    useState("any");

  const [date, setDate] = useState("");

  const [availability, setAvailability] =
    useState<AvailabilityResult | null>(null);

  const [selectedSlot, setSelectedSlot] =
    useState<AvailabilitySlot | null>(null);

  const [clientComment, setClientComment] =
    useState("");

  const [
    inspirationFiles,
    setInspirationFiles,
  ] = useState<File[]>([]);

  const [
    uploadedImages,
    setUploadedImages,
  ] = useState<UploadedAppointmentImage[]>([]);

  const [acceptedTerms, setAcceptedTerms] =
    useState(false);

  const [
    loadingAvailability,
    setLoadingAvailability,
  ] = useState(false);

  const [submitting, setSubmitting] =
    useState(false);

  const [
    availabilityRefreshKey,
    setAvailabilityRefreshKey,
  ] = useState(0);

  const [
    availabilityError,
    setAvailabilityError,
  ] = useState<string | null>(null);

  const [
    submissionError,
    setSubmissionError,
  ] = useState<string | null>(null);

  const services = useMemo(
    () =>
      categories.flatMap(
        (category) => category.services,
      ),
    [categories],
  );

  const selectedServices = useMemo(
    () =>
      services.filter((service) =>
        serviceIds.includes(service.id),
      ),
    [serviceIds, services],
  );

  const compatibleStaff = useMemo(
    () =>
      staffMembers.filter((staff) =>
        serviceIds.every((serviceId) =>
          staff.serviceIds.includes(serviceId),
        ),
      ),
    [serviceIds, staffMembers],
  );

  const resolvedStaffId = useMemo(() => {
    if (staffId === "any") {
      return "any";
    }

    const staffIsStillCompatible =
      compatibleStaff.some(
        (staff) => staff.id === staffId,
      );

    return staffIsStillCompatible
      ? staffId
      : "any";
  }, [compatibleStaff, staffId]);

  const selectedStaff = useMemo(
    () =>
      resolvedStaffId === "any"
        ? null
        : compatibleStaff.find(
            (staff) =>
              staff.id === resolvedStaffId,
          ) ?? null,
    [compatibleStaff, resolvedStaffId],
  );

  const estimatedPriceCents = useMemo(
    () =>
      selectedServices.reduce(
        (total, service) =>
          total +
          (service.promotionalPriceCents ??
            service.priceCents),
        0,
      ),
    [selectedServices],
  );

  const estimatedDurationMinutes = useMemo(
    () =>
      selectedServices.reduce(
        (total, service) =>
          total + service.durationMinutes,
        0,
      ),
    [selectedServices],
  );

  const totalPriceCents =
    availability?.totalPriceCents ??
    estimatedPriceCents;

  const totalDurationMinutes =
    availability?.totalDurationMinutes ??
    estimatedDurationMinutes;

  const depositCents =
    availability?.depositCents ??
    (totalPriceCents > 0
      ? Math.min(totalPriceCents, 3_500)
      : 0);

  const remainingCents = Math.max(
    totalPriceCents - depositCents,
    0,
  );

  const reservationSummary =
    useMemo<ReservationSummaryData>(
      () => ({
        totalPriceCents,
        totalDurationMinutes,
        depositCents,
        remainingCents,
        isFullPayment:
          depositCents > 0 &&
          depositCents === totalPriceCents,
      }),
      [
        depositCents,
        remainingCents,
        totalDurationMinutes,
        totalPriceCents,
      ],
    );

  const currentStep =
    useMemo<ReservationStep>(() => {
      if (serviceIds.length === 0) {
        return 1;
      }

      if (!date || !selectedSlot) {
        return 3;
      }

      return 4;
    }, [
      date,
      selectedSlot,
      serviceIds.length,
    ]);

  const completedStep = useMemo(() => {
    if (serviceIds.length === 0) {
      return 0;
    }

    if (!date) {
      return 2;
    }

    if (!selectedSlot) {
      return 3;
    }

    return 4;
  }, [
    date,
    selectedSlot,
    serviceIds.length,
  ]);

  const canSelectCalendar =
    serviceIds.length > 0 &&
    compatibleStaff.length > 0;

  const hasSelectedStaff =
    serviceIds.length > 0 &&
    compatibleStaff.length > 0;

  useEffect(() => {
    if (
      !date ||
      serviceIds.length === 0 ||
      compatibleStaff.length === 0
    ) {
      return;
    }

    const controller = new AbortController();

    const scrollTimer = window.setTimeout(() => {
      slotsSectionRef.current?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }, 180);

    async function loadAvailability(): Promise<void> {
      setLoadingAvailability(true);
      setAvailabilityError(null);

      try {
        const params = new URLSearchParams({
          staffId: resolvedStaffId,
          date,
        });

        serviceIds.forEach((serviceId) => {
          params.append(
            "serviceId",
            serviceId,
          );
        });

        const response = await fetch(
          `/api/availability?${params.toString()}`,
          {
            method: "GET",
            signal: controller.signal,
            headers: {
              Accept: "application/json",
            },
          },
        );

        const payload =
          (await response.json()) as
            AvailabilityResult & {
              message?: string;
            };

        if (!response.ok) {
          throw new Error(
            payload.message ??
              "Les disponibilités sont momentanément indisponibles.",
          );
        }

        if (!controller.signal.aborted) {
          setAvailability(payload);
        }
      } catch (reason: unknown) {
        if (
          reason instanceof DOMException &&
          reason.name === "AbortError"
        ) {
          return;
        }

        if (!controller.signal.aborted) {
          setAvailability(null);

          setAvailabilityError(
            reason instanceof Error
              ? reason.message
              : "Une erreur est survenue pendant la recherche des créneaux.",
          );
        }
      } finally {
        if (!controller.signal.aborted) {
          setLoadingAvailability(false);
        }
      }
    }

    void loadAvailability();

    return () => {
      window.clearTimeout(scrollTimer);
      controller.abort();
    };
  }, [
    availabilityRefreshKey,
    compatibleStaff.length,
    date,
    resolvedStaffId,
    serviceIds,
  ]);

  function resetAvailability(): void {
    setAvailability(null);
    setSelectedSlot(null);
    setAvailabilityError(null);
    setSubmissionError(null);
    setAcceptedTerms(false);
  }

  function refreshAvailability(
    message?: string,
  ): void {
    setSelectedSlot(null);
    setAcceptedTerms(false);
    setSubmissionError(null);
    setAvailabilityError(message ?? null);

    setAvailabilityRefreshKey(
      (current) => current + 1,
    );
  }

  function toggleService(
    serviceId: string,
  ): void {
    resetAvailability();

    setServiceIds((current) =>
      current.includes(serviceId)
        ? current.filter(
            (currentServiceId) =>
              currentServiceId !== serviceId,
          )
        : [...current, serviceId],
    );
  }

  function selectStaff(
    nextStaffId: string,
  ): void {
    resetAvailability();
    setStaffId(nextStaffId);
  }

  function selectDate(
    nextDate: string,
  ): void {
    resetAvailability();
    setDate(nextDate);
  }

  function selectSlot(
    slot: AvailabilitySlot,
  ): void {
    setSelectedSlot(slot);
    setAvailabilityError(null);
    setSubmissionError(null);
    setAcceptedTerms(false);
  }

  async function submitAppointment(): Promise<void> {
    if (
      !selectedSlot ||
      submitting ||
      !acceptedTerms
    ) {
      return;
    }

    if (
      inspirationFiles.length > 0 &&
      uploadedImages.length === 0
    ) {
      setSubmissionError(
        "Veuillez envoyer vos photos d’inspiration avant de confirmer la réservation.",
      );

      return;
    }

    const selectedSlotKey =
      createSlotKey(selectedSlot);

    const slotStillBelongsToLatestAvailability =
      availability?.slots.some(
        (slot) =>
          createSlotKey(slot) ===
          selectedSlotKey,
      ) ?? false;

    if (!slotStillBelongsToLatestAvailability) {
      refreshAvailability(
        "Ce créneau n’appartient plus aux disponibilités actuelles. Les horaires viennent d’être actualisés.",
      );

      return;
    }

    const appointmentPayload = {
      serviceIds: [...serviceIds],
      startsAt: selectedSlot.startsAt,
      endsAt: selectedSlot.endsAt,
      staffId: selectedSlot.staff.id,
      workstationId:
        selectedSlot.workstation.id,
      clientComment:
        clientComment.trim(),
      images: uploadedImages.map((image) => ({
        url: image.url,
        fileName: image.fileName,
        mimeType: image.mimeType,
        sizeBytes: image.sizeBytes,
      })),
    };

    setSubmitting(true);
    setSubmissionError(null);
    setAvailabilityError(null);

    try {
      const response = await fetch(
        "/api/appointments",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(
            appointmentPayload,
          ),
        },
      );

      const payload =
        (await response.json()) as
          CreateAppointmentResponse;

      if (response.status === 401) {
        const callbackUrl =
          `${pathname}?services=${encodeURIComponent(
            serviceIds.join(","),
          )}`;

        router.push(
          `/connexion?callbackUrl=${encodeURIComponent(
            callbackUrl,
          )}`,
        );

        return;
      }

      if (
        response.status === 409 ||
        payload.code === "SLOT_UNAVAILABLE"
      ) {
        refreshAvailability(
          payload.message ??
            "Ce créneau vient d’être réservé par une autre cliente. Les disponibilités ont été actualisées.",
        );

        return;
      }

      if (
        !response.ok ||
        !payload.confirmationUrl
      ) {
        throw new Error(
          payload.message ??
            "Impossible de créer le rendez-vous.",
        );
      }

      router.push(
        payload.confirmationUrl,
      );

      router.refresh();
    } catch (reason: unknown) {
      setSubmissionError(
        reason instanceof Error
          ? reason.message
          : "Une erreur est survenue pendant la réservation.",
      );
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <div className="relative overflow-hidden">
      <div className="pointer-events-none absolute left-1/2 top-0 -z-10 h-[38rem] w-[70rem] -translate-x-1/2 rounded-full bg-gradient-to-b from-[#F9E5E9]/70 via-[#FFF3F0]/45 to-transparent blur-3xl" />

      <div className="mx-auto max-w-[90rem] px-4 pb-32 pt-8 sm:px-6 sm:pt-12 lg:px-8 lg:pb-16">
        <header className="mx-auto mb-8 max-w-4xl text-center sm:mb-10">
          <span className="inline-flex items-center gap-2 rounded-full border border-[#241A1D]/8 bg-white/80 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-[#9D6378] shadow-sm backdrop-blur">
            <Sparkles className="size-4" />
            Le Palais des Ongles
          </span>

          <h1 className="mt-5 font-serif text-4xl leading-tight text-[#241A1D] sm:text-5xl lg:text-6xl">
            Réservez votre moment beauté
          </h1>

          <p className="mx-auto mt-4 max-w-2xl text-sm leading-7 text-[#78666D] sm:text-base">
            Choisissez vos prestations, votre
            professionnelle et un créneau réellement
            disponible au salon.
          </p>
        </header>

        <ReservationProgress
          currentStep={currentStep}
          completedStep={completedStep}
        />

        <div className="mt-8 grid items-start gap-8 xl:grid-cols-[minmax(0,1fr)_380px]">
          <main className="min-w-0 space-y-8">
            <ReservationServices
              categories={categories}
              selectedServiceIds={serviceIds}
              onToggleService={toggleService}
            />

            <ReservationStaff
              selectedServiceIds={serviceIds}
              staffMembers={staffMembers}
              compatibleStaff={compatibleStaff}
              selectedStaffId={resolvedStaffId}
              onSelectStaff={selectStaff}
            />

            <ReservationCalendar
              value={date}
              minDate={todayInParis()}
              disabled={!canSelectCalendar}
              selectedServiceCount={
                serviceIds.length
              }
              compatibleStaffCount={
                compatibleStaff.length
              }
              onChange={selectDate}
            />

            <div
              ref={slotsSectionRef}
              className="scroll-mt-24"
            >
              <ReservationSlots
                date={date}
                availability={availability}
                selectedSlot={selectedSlot}
                loading={loadingAvailability}
                error={availabilityError}
                disabled={
                  !canSelectCalendar ||
                  submitting
                }
                onSelectSlot={selectSlot}
                onRefresh={() =>
                  refreshAvailability()
                }
              />
            </div>

            <ReservationComment
              value={clientComment}
              disabled={submitting}
              maxLength={500}
              onChange={setClientComment}
            />

            <ReservationUpload
              files={inspirationFiles}
              uploadedImages={uploadedImages}
              disabled={submitting}
              maxFiles={5}
              onFilesChange={
                setInspirationFiles
              }
              onUploadedImagesChange={
                setUploadedImages
              }
            />

            <ReservationPayment
              summary={reservationSummary}
              disabled={!selectedSlot}
            />

            <ReservationConfirm
              summary={reservationSummary}
              selectedServiceCount={
                serviceIds.length
              }
              hasSelectedStaff={
                hasSelectedStaff
              }
              hasSelectedDate={
                date.length > 0
              }
              hasSelectedSlot={
                selectedSlot !== null
              }
              acceptedTerms={acceptedTerms}
              submitting={submitting}
              disabled={
                loadingAvailability
              }
              error={submissionError}
              onAcceptedTermsChange={
                setAcceptedTerms
              }
              onConfirm={() => {
                void submitAppointment();
              }}
            />
          </main>

          <div className="hidden xl:sticky xl:top-24 xl:block">
            <ReservationSummary
              selectedServices={
                selectedServices
              }
              selectedStaff={selectedStaff}
              selectedStaffId={
                resolvedStaffId
              }
              selectedDate={date}
              selectedSlot={selectedSlot}
              summary={reservationSummary}
            />
          </div>
        </div>

        <div className="mt-8 xl:hidden">
          <ReservationSummary
            selectedServices={
              selectedServices
            }
            selectedStaff={selectedStaff}
            selectedStaffId={
              resolvedStaffId
            }
            selectedDate={date}
            selectedSlot={selectedSlot}
            summary={reservationSummary}
            compact
          />
        </div>
      </div>
    </div>
  );
}