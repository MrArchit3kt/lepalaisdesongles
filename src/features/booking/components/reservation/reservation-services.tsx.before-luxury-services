"use client";

import {
  Check,
  Clock3,
  CreditCard,
  Layers3,
  Plus,
  Sparkles,
} from "lucide-react";

import { cn } from "@/lib/utils";

import type {
  Category,
  ServiceItem,
} from "./reservation.types";

type ReservationServicesProps = {
  categories: Category[];
  selectedServiceIds: string[];
  onToggleService: (serviceId: string) => void;
};

function formatPrice(cents: number): string {
  return new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR",
  }).format(cents / 100);
}

function getDisplayedPrice(
  service: ServiceItem,
): number {
  return (
    service.promotionalPriceCents ??
    service.priceCents
  );
}

function hasPromotion(
  service: ServiceItem,
): boolean {
  return (
    service.promotionalPriceCents !== null &&
    service.promotionalPriceCents <
      service.priceCents
  );
}

export function ReservationServices({
  categories,
  selectedServiceIds,
  onToggleService,
}: ReservationServicesProps) {
  const selectedCount =
    selectedServiceIds.length;

  const totalServiceCount =
    categories.reduce(
      (total, category) =>
        total + category.services.length,
      0,
    );

  return (
    <section
      id="reservation-services"
      aria-labelledby="reservation-services-title"
      className="relative overflow-hidden rounded-[2rem] border border-[#241A1D]/8 bg-white p-5 shadow-[0_30px_90px_-55px_rgba(73,41,52,0.55)] sm:p-7 lg:p-8"
    >
      <div className="pointer-events-none absolute -right-24 -top-24 size-64 rounded-full bg-[#F8E4E8]/70 blur-3xl" />

      <div className="pointer-events-none absolute -bottom-32 -left-24 size-72 rounded-full bg-[#FFF1ED]/80 blur-3xl" />

      <div className="relative">
        <header className="flex flex-col gap-5 border-b border-[#241A1D]/8 pb-6 sm:flex-row sm:items-start sm:justify-between">
          <div className="flex items-start gap-4">
            <span className="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#D79AAF] via-[#B8768E] to-[#7A485A] text-white shadow-lg shadow-[#B8768E]/20">
              <Sparkles className="size-5" />
            </span>

            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.22em] text-[#A56C80]">
                Étape 1
              </p>

              <h2
                id="reservation-services-title"
                className="mt-1 font-serif text-3xl text-[#241A1D] sm:text-4xl"
              >
                Choisissez vos prestations
              </h2>

              <p className="mt-2 max-w-2xl text-sm leading-7 text-[#79676E]">
                Vous pouvez sélectionner plusieurs
                prestations. La durée et le prix seront
                automatiquement calculés dans votre
                résumé.
              </p>
            </div>
          </div>

          <div className="flex shrink-0 items-center gap-3">
            <span className="inline-flex items-center gap-2 rounded-full border border-[#241A1D]/8 bg-[#FFF8F7] px-4 py-2 text-xs font-semibold text-[#765A64]">
              <Layers3 className="size-4 text-[#B77C91]" />

              {totalServiceCount} prestation
              {totalServiceCount > 1 ? "s" : ""}
            </span>

            {selectedCount > 0 ? (
              <span className="inline-flex items-center gap-2 rounded-full bg-[#241A1D] px-4 py-2 text-xs font-semibold text-white shadow-sm">
                <Check className="size-4" />

                {selectedCount} sélectionnée
                {selectedCount > 1 ? "s" : ""}
              </span>
            ) : null}
          </div>
        </header>

        {categories.length > 0 ? (
          <div className="mt-8 space-y-10">
            {categories.map((category) => (
              <section
                key={category.id}
                aria-labelledby={`category-${category.id}`}
              >
                <div className="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <h3
                      id={`category-${category.id}`}
                      className="font-serif text-2xl text-[#241A1D]"
                    >
                      {category.name}
                    </h3>

                    {category.description ? (
                      <p className="mt-1 max-w-2xl text-sm leading-6 text-[#846F77]">
                        {category.description}
                      </p>
                    ) : null}
                  </div>

                  <span className="text-xs font-semibold uppercase tracking-[0.16em] text-[#AD929B]">
                    {category.services.length} choix
                  </span>
                </div>

                <div className="grid gap-4 md:grid-cols-2">
                  {category.services.map(
                    (service) => {
                      const selected =
                        selectedServiceIds.includes(
                          service.id,
                        );

                      const displayedPrice =
                        getDisplayedPrice(service);

                      const promotion =
                        hasPromotion(service);

                      return (
                        <button
                          key={service.id}
                          type="button"
                          onClick={() =>
                            onToggleService(
                              service.id,
                            )
                          }
                          aria-pressed={selected}
                          className={cn(
                            "group relative flex min-h-48 flex-col overflow-hidden rounded-[1.65rem] border p-5 text-left outline-none transition duration-300 focus-visible:ring-4 focus-visible:ring-[#DFAFBC]/30 sm:p-6",
                            selected
                              ? "border-[#AA6C82] bg-gradient-to-br from-[#FFF8F7] via-[#FFF0F1] to-[#F8E3E8] shadow-[0_24px_60px_-35px_rgba(116,66,83,0.55)] ring-1 ring-[#C58A9E]/30"
                              : "border-[#241A1D]/8 bg-[#FFFCFB] shadow-sm hover:-translate-y-1 hover:border-[#C798A8]/60 hover:bg-white hover:shadow-[0_25px_60px_-38px_rgba(79,43,55,0.35)]",
                          )}
                        >
                          <span
                            aria-hidden="true"
                            className={cn(
                              "pointer-events-none absolute -right-12 -top-14 size-36 rounded-full blur-2xl transition duration-300",
                              selected
                                ? "bg-[#EEC6D0]/65"
                                : "bg-[#F8E8E9]/0 group-hover:bg-[#F8E8E9]/70",
                            )}
                          />

                          <div className="relative flex items-start justify-between gap-4">
                            <div className="min-w-0 flex-1">
                              <div className="flex flex-wrap items-center gap-2">
                                {promotion ? (
                                  <span className="inline-flex rounded-full bg-[#241A1D] px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-white">
                                    Offre spéciale
                                  </span>
                                ) : null}

                                {service.depositRequired ? (
                                  <span className="inline-flex items-center gap-1.5 rounded-full border border-[#B98597]/15 bg-white/75 px-3 py-1 text-[0.68rem] font-semibold text-[#8E6070]">
                                    <CreditCard className="size-3" />
                                    Acompte
                                  </span>
                                ) : null}
                              </div>

                              <h4 className="mt-3 pr-2 font-serif text-2xl leading-tight text-[#241A1D]">
                                {service.name}
                              </h4>
                            </div>

                            <span
                              className={cn(
                                "grid size-10 shrink-0 place-items-center rounded-full border transition duration-300",
                                selected
                                  ? "border-[#8C566A] bg-[#241A1D] text-white shadow-lg shadow-[#241A1D]/15"
                                  : "border-[#241A1D]/10 bg-white text-[#9A858D] group-hover:border-[#BC8397] group-hover:text-[#9B6378]",
                              )}
                            >
                              {selected ? (
                                <Check className="size-5" />
                              ) : (
                                <Plus className="size-5" />
                              )}
                            </span>
                          </div>

                          <p className="relative mt-3 line-clamp-3 text-sm leading-6 text-[#78666D]">
                            {service.shortDescription ??
                              "Découvrez cette prestation personnalisable selon vos envies et votre style."}
                          </p>

                          <div className="relative mt-auto flex flex-wrap items-end justify-between gap-4 pt-6">
                            <div className="flex flex-wrap items-center gap-2">
                              <span className="inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-2 text-xs font-semibold text-[#725F66] shadow-sm">
                                <Clock3 className="size-4 text-[#B77A90]" />

                                {
                                  service.durationMinutes
                                }{" "}
                                min
                              </span>

                              {service.depositRequired &&
                              service.depositCents ? (
                                <span className="inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-2 text-xs font-semibold text-[#725F66] shadow-sm">
                                  <CreditCard className="size-4 text-[#B77A90]" />

                                  Acompte{" "}
                                  {formatPrice(
                                    service.depositCents,
                                  )}
                                </span>
                              ) : null}
                            </div>

                            <div className="text-right">
                              {promotion ? (
                                <p className="text-xs text-[#A49198] line-through">
                                  {formatPrice(
                                    service.priceCents,
                                  )}
                                </p>
                              ) : null}

                              <p className="text-xl font-semibold text-[#241A1D]">
                                {formatPrice(
                                  displayedPrice,
                                )}
                              </p>
                            </div>
                          </div>

                          {selected ? (
                            <div className="relative mt-5 flex items-center gap-2 border-t border-[#A96D82]/15 pt-4 text-xs font-semibold text-[#8C566A]">
                              <Check className="size-4" />
                              Ajoutée à votre réservation
                            </div>
                          ) : (
                            <div className="relative mt-5 flex items-center gap-2 border-t border-[#241A1D]/6 pt-4 text-xs font-semibold text-[#8E7A81] transition group-hover:text-[#8C566A]">
                              <Plus className="size-4" />
                              Ajouter cette prestation
                            </div>
                          )}
                        </button>
                      );
                    },
                  )}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <div className="mt-8 rounded-[1.75rem] border border-dashed border-[#241A1D]/15 bg-[#FFF9F8] px-6 py-14 text-center">
            <span className="mx-auto grid size-14 place-items-center rounded-full bg-white text-[#A76D81] shadow-sm">
              <Sparkles className="size-6" />
            </span>

            <h3 className="mt-5 font-serif text-2xl text-[#241A1D]">
              Aucune prestation disponible
            </h3>

            <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-[#79676E]">
              Les prestations réservables seront bientôt
              affichées ici.
            </p>
          </div>
        )}
      </div>
    </section>
  );
}