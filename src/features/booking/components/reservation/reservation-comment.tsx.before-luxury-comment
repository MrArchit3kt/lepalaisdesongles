"use client";

import {
  CheckCircle2,
  MessageSquareText,
  Sparkles,
} from "lucide-react";

import { cn } from "@/lib/utils";

type ReservationCommentProps = {
  value: string;
  disabled?: boolean;
  maxLength?: number;
  onChange: (value: string) => void;
};

export function ReservationComment({
  value,
  disabled = false,
  maxLength = 1000,
  onChange,
}: ReservationCommentProps) {
  const characterCount = value.length;

  const remainingCharacters =
    maxLength - characterCount;

  const hasComment =
    value.trim().length > 0;

  const isNearLimit =
    remainingCharacters <= 100;

  return (
    <section
      id="reservation-comment"
      aria-labelledby="reservation-comment-title"
      className="relative overflow-hidden rounded-[2rem] border border-[#241A1D]/8 bg-white p-5 shadow-[0_30px_90px_-55px_rgba(73,41,52,0.55)] sm:p-7 lg:p-8"
    >
      <div className="pointer-events-none absolute -right-24 -top-24 size-64 rounded-full bg-[#F7E4E8]/70 blur-3xl" />

      <div className="pointer-events-none absolute -bottom-28 -left-20 size-64 rounded-full bg-[#FFF1ED]/75 blur-3xl" />

      <div className="relative">
        <header className="flex flex-col gap-5 border-b border-[#241A1D]/8 pb-6 sm:flex-row sm:items-start sm:justify-between">
          <div className="flex items-start gap-4">
            <span className="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#D79AAF] via-[#B8768E] to-[#7A485A] text-white shadow-lg shadow-[#B8768E]/20">
              <MessageSquareText className="size-5" />
            </span>

            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.22em] text-[#A56C80]">
                Votre rendez-vous
              </p>

              <h2
                id="reservation-comment-title"
                className="mt-1 font-serif text-3xl text-[#241A1D] sm:text-4xl"
              >
                Une demande particulière ?
              </h2>

              <p className="mt-2 max-w-2xl text-sm leading-7 text-[#79676E]">
                Précisez vos envies, votre style,
                les couleurs souhaitées ou toute
                information utile pour préparer votre
                rendez-vous.
              </p>
            </div>
          </div>

          {hasComment ? (
            <span className="inline-flex w-fit shrink-0 items-center gap-2 rounded-full bg-[#241A1D] px-4 py-2 text-xs font-semibold text-white">
              <CheckCircle2 className="size-4" />
              Message ajouté
            </span>
          ) : (
            <span className="inline-flex w-fit shrink-0 items-center gap-2 rounded-full border border-[#241A1D]/8 bg-[#FFF8F7] px-4 py-2 text-xs font-semibold text-[#765A64]">
              <Sparkles className="size-4 text-[#B77C91]" />
              Facultatif
            </span>
          )}
        </header>

        <div className="mt-8">
          <label
            htmlFor="reservation-client-comment"
            className="mb-3 block text-sm font-semibold text-[#3D3035]"
          >
            Votre message
          </label>

          <div
            className={cn(
              "relative overflow-hidden rounded-[1.75rem] border bg-[#FFFCFB] transition duration-300",
              hasComment
                ? "border-[#B97A90]/50 shadow-[0_20px_50px_-35px_rgba(111,63,80,0.45)] ring-1 ring-[#D5A3B2]/15"
                : "border-[#241A1D]/10 focus-within:border-[#B97A90]/60 focus-within:shadow-[0_20px_50px_-35px_rgba(111,63,80,0.4)] focus-within:ring-4 focus-within:ring-[#E8C8D1]/25",
            )}
          >
            <div className="pointer-events-none absolute -right-12 -top-12 size-36 rounded-full bg-[#F6E1E6]/70 blur-3xl" />

            <textarea
              id="reservation-client-comment"
              name="clientComment"
              value={value}
              onChange={(event) =>
                onChange(event.target.value)
              }
              maxLength={maxLength}
              disabled={disabled}
              rows={7}
              placeholder="Exemple : Je souhaiterais une forme amande, une base nude rosée et une inspiration french fine avec quelques détails dorés…"
              className="relative min-h-44 w-full resize-y bg-transparent px-5 py-5 text-sm leading-7 text-[#35292E] outline-none placeholder:text-[#AD9AA1] disabled:cursor-not-allowed disabled:opacity-60 sm:px-6 sm:py-6"
            />

            <div className="relative flex flex-col gap-3 border-t border-[#241A1D]/7 bg-white/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
              <p className="text-xs leading-5 text-[#8F7A82]">
                Ne transmettez aucune donnée bancaire
                ou information confidentielle.
              </p>

              <span
                className={cn(
                  "shrink-0 text-xs font-semibold tabular-nums",
                  isNearLimit
                    ? "text-[#B45C5C]"
                    : "text-[#8C747D]",
                )}
              >
                {characterCount} / {maxLength}
              </span>
            </div>
          </div>

          <div className="mt-4 grid gap-3 sm:grid-cols-3">
            <div className="rounded-2xl border border-[#241A1D]/8 bg-[#FFF9F8] p-4">
              <p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#A08790]">
                Forme
              </p>

              <p className="mt-2 text-sm font-semibold text-[#241A1D]">
                Carrée, amande, coffin…
              </p>
            </div>

            <div className="rounded-2xl border border-[#241A1D]/8 bg-[#FFF9F8] p-4">
              <p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#A08790]">
                Style
              </p>

              <p className="mt-2 text-sm font-semibold text-[#241A1D]">
                Nude, french, nail art…
              </p>
            </div>

            <div className="rounded-2xl border border-[#241A1D]/8 bg-[#FFF9F8] p-4">
              <p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#A08790]">
                Détails
              </p>

              <p className="mt-2 text-sm font-semibold text-[#241A1D]">
                Couleurs et inspirations
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}