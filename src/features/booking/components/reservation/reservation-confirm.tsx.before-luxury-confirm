"use client";

import {
  AlertCircle,
  CalendarCheck2,
  Check,
  CheckCircle2,
  Circle,
  CreditCard,
  LoaderCircle,
  LockKeyhole,
  ShieldCheck,
  Sparkles,
} from "lucide-react";

import { cn } from "@/lib/utils";

import type {
  ReservationSummary,
} from "./reservation.types";

type ReservationConfirmProps = {
  summary: ReservationSummary;
  selectedServiceCount: number;
  hasSelectedStaff: boolean;
  hasSelectedDate: boolean;
  hasSelectedSlot: boolean;
  acceptedTerms: boolean;
  submitting?: boolean;
  disabled?: boolean;
  error?: string | null;
  onAcceptedTermsChange: (
    accepted: boolean,
  ) => void;
  onConfirm: () => void;
};

type ValidationItem = {
  id: string;
  label: string;
  description: string;
  completed: boolean;
};

function formatPrice(cents: number): string {
  return new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR",
  }).format(cents / 100);
}

export function ReservationConfirm({
  summary,
  selectedServiceCount,
  hasSelectedStaff,
  hasSelectedDate,
  hasSelectedSlot,
  acceptedTerms,
  submitting = false,
  disabled = false,
  error = null,
  onAcceptedTermsChange,
  onConfirm,
}: ReservationConfirmProps) {
  const hasSelectedServices =
    selectedServiceCount > 0;

  const validationItems: ValidationItem[] = [
    {
      id: "services",
      label: "Prestations sélectionnées",
      description: hasSelectedServices
        ? `${selectedServiceCount} prestation${
            selectedServiceCount > 1 ? "s" : ""
          } ajoutée${
            selectedServiceCount > 1 ? "s" : ""
          }`
        : "Choisissez au moins une prestation",
      completed: hasSelectedServices,
    },
    {
      id: "staff",
      label: "Professionnelle choisie",
      description: hasSelectedStaff
        ? "Votre préférence est enregistrée"
        : "Sélectionnez une professionnelle",
      completed: hasSelectedStaff,
    },
    {
      id: "date",
      label: "Date sélectionnée",
      description: hasSelectedDate
        ? "La journée du rendez-vous est définie"
        : "Choisissez une date",
      completed: hasSelectedDate,
    },
    {
      id: "slot",
      label: "Créneau réservé",
      description: hasSelectedSlot
        ? "L’horaire est prêt à être confirmé"
        : "Sélectionnez un horaire disponible",
      completed: hasSelectedSlot,
    },
  ];

  const completedItemCount =
    validationItems.filter(
      (item) => item.completed,
    ).length;

  const reservationIsComplete =
    validationItems.every(
      (item) => item.completed,
    );

  const requiresOnlinePayment =
    summary.depositCents > 0;

  const confirmDisabled =
    disabled ||
    submitting ||
    !reservationIsComplete ||
    !acceptedTerms;

  const confirmationLabel =
    requiresOnlinePayment
      ? summary.isFullPayment
        ? `Payer ${formatPrice(
            summary.depositCents,
          )} et confirmer`
        : `Payer l’acompte de ${formatPrice(
            summary.depositCents,
          )}`
      : "Confirmer ma demande";

  return (
    <section
      id="reservation-confirm"
      aria-labelledby="reservation-confirm-title"
      className="relative overflow-hidden rounded-[2rem] border border-[#241A1D]/8 bg-white p-5 shadow-[0_30px_90px_-55px_rgba(73,41,52,0.55)] sm:p-7 lg:p-8"
    >
      <div className="pointer-events-none absolute -right-24 -top-24 size-64 rounded-full bg-[#F7E4E8]/70 blur-3xl" />

      <div className="pointer-events-none absolute -bottom-28 -left-20 size-64 rounded-full bg-[#FFF1ED]/75 blur-3xl" />

      <div className="relative">
        <header className="flex flex-col gap-5 border-b border-[#241A1D]/8 pb-6 sm:flex-row sm:items-start sm:justify-between">
          <div className="flex items-start gap-4">
            <span className="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#D79AAF] via-[#B8768E] to-[#7A485A] text-white shadow-lg shadow-[#B8768E]/20">
              <CalendarCheck2 className="size-5" />
            </span>

            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.22em] text-[#A56C80]">
                Étape 4
              </p>

              <h2
                id="reservation-confirm-title"
                className="mt-1 font-serif text-3xl text-[#241A1D] sm:text-4xl"
              >
                Confirmez votre rendez-vous
              </h2>

              <p className="mt-2 max-w-2xl text-sm leading-7 text-[#79676E]">
                Vérifiez que tous les éléments sont
                renseignés, puis validez votre demande
                de réservation.
              </p>
            </div>
          </div>

          <span
            className={cn(
              "inline-flex w-fit shrink-0 items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold",
              reservationIsComplete
                ? "bg-[#241A1D] text-white"
                : "border border-[#241A1D]/8 bg-[#FFF8F7] text-[#765A64]",
            )}
          >
            {reservationIsComplete ? (
              <CheckCircle2 className="size-4" />
            ) : (
              <Sparkles className="size-4 text-[#B77C91]" />
            )}

            {completedItemCount} /{" "}
            {validationItems.length} complété
            {completedItemCount > 1 ? "s" : ""}
          </span>
        </header>

        <div className="mt-8 grid gap-5 lg:grid-cols-[1fr_0.85fr]">
          <div className="space-y-3">
            {validationItems.map((item) => (
              <div
                key={item.id}
                className={cn(
                  "flex items-start gap-4 rounded-[1.35rem] border p-4 transition",
                  item.completed
                    ? "border-[#8CB99A]/30 bg-[#F6FCF7]"
                    : "border-[#241A1D]/8 bg-[#FFF9F8]",
                )}
              >
                <span
                  className={cn(
                    "mt-0.5 grid size-9 shrink-0 place-items-center rounded-full border",
                    item.completed
                      ? "border-[#6B9D7A]/15 bg-white text-[#4B8A60]"
                      : "border-[#241A1D]/8 bg-white text-[#AF9AA2]",
                  )}
                >
                  {item.completed ? (
                    <Check className="size-4" />
                  ) : (
                    <Circle className="size-3.5" />
                  )}
                </span>

                <div>
                  <p
                    className={cn(
                      "text-sm font-semibold",
                      item.completed
                        ? "text-[#294331]"
                        : "text-[#3B2E33]",
                    )}
                  >
                    {item.label}
                  </p>

                  <p
                    className={cn(
                      "mt-1 text-xs leading-5",
                      item.completed
                        ? "text-[#68806E]"
                        : "text-[#907B83]",
                    )}
                  >
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <div className="relative overflow-hidden rounded-[1.75rem] border border-[#241A1D]/8 bg-[#241A1D] p-5 text-white sm:p-6">
            <div className="pointer-events-none absolute -right-16 -top-16 size-44 rounded-full bg-[#B8778E]/30 blur-3xl" />

            <div className="relative">
              <span className="grid size-11 place-items-center rounded-2xl bg-white/10 text-[#ECC1CE] ring-1 ring-white/10">
                {requiresOnlinePayment ? (
                  <CreditCard className="size-5" />
                ) : (
                  <CalendarCheck2 className="size-5" />
                )}
              </span>

              <p className="mt-5 text-xs font-semibold uppercase tracking-[0.17em] text-[#E1AFC0]">
                Validation finale
              </p>

              <h3 className="mt-2 font-serif text-2xl">
                {requiresOnlinePayment
                  ? summary.isFullPayment
                    ? "Paiement intégral"
                    : "Acompte sécurisé"
                  : "Demande de réservation"}
              </h3>

              <p className="mt-3 text-sm leading-6 text-white/60">
                {requiresOnlinePayment
                  ? "Vous serez dirigée vers l’espace de paiement sécurisé afin de finaliser la réservation."
                  : "Votre demande sera transmise au salon. Vous recevrez ensuite les informations de suivi de votre rendez-vous."}
              </p>

              <div className="mt-5 rounded-[1.35rem] border border-white/10 bg-white/[0.07] p-4">
                <div className="flex items-center justify-between gap-4">
                  <span className="text-sm text-white/60">
                    Total
                  </span>

                  <span className="text-sm font-semibold">
                    {formatPrice(
                      summary.totalPriceCents,
                    )}
                  </span>
                </div>

                {requiresOnlinePayment ? (
                  <>
                    <div className="mt-3 flex items-center justify-between gap-4">
                      <span className="text-sm text-white/60">
                        À régler maintenant
                      </span>

                      <span className="font-serif text-2xl text-[#F0C4D1]">
                        {formatPrice(
                          summary.depositCents,
                        )}
                      </span>
                    </div>

                    {summary.remainingCents > 0 ? (
                      <div className="mt-3 flex items-center justify-between gap-4 border-t border-white/10 pt-3">
                        <span className="text-xs text-white/45">
                          Reste au salon
                        </span>

                        <span className="text-xs font-semibold text-white/75">
                          {formatPrice(
                            summary.remainingCents,
                          )}
                        </span>
                      </div>
                    ) : null}
                  </>
                ) : (
                  <div className="mt-3 flex items-center justify-between gap-4">
                    <span className="text-sm text-white/60">
                      Paiement en ligne
                    </span>

                    <span className="text-sm font-semibold text-[#D1E8D7]">
                      Aucun
                    </span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        <label
          className={cn(
            "mt-6 flex cursor-pointer items-start gap-4 rounded-[1.5rem] border p-5 transition",
            acceptedTerms
              ? "border-[#A96D82]/30 bg-[#FFF4F5] ring-1 ring-[#C98EA1]/10"
              : "border-[#241A1D]/8 bg-[#FFF9F8] hover:border-[#C38A9E]/40",
            (disabled || submitting) &&
              "cursor-not-allowed opacity-60",
          )}
        >
          <input
            type="checkbox"
            checked={acceptedTerms}
            disabled={disabled || submitting}
            onChange={(event) =>
              onAcceptedTermsChange(
                event.target.checked,
              )
            }
            className="sr-only"
          />

          <span
            aria-hidden="true"
            className={cn(
              "mt-0.5 grid size-6 shrink-0 place-items-center rounded-lg border transition",
              acceptedTerms
                ? "border-[#241A1D] bg-[#241A1D] text-white"
                : "border-[#241A1D]/15 bg-white text-transparent",
            )}
          >
            <Check className="size-4" />
          </span>

          <span className="min-w-0">
            <span className="block text-sm font-semibold text-[#35292E]">
              J’accepte les conditions de réservation
            </span>

            <span className="mt-1 block text-xs leading-5 text-[#88747C]">
              Je confirme avoir vérifié les prestations,
              la date, l’horaire et les montants de ma
              réservation. J’accepte également les
              conditions d’annulation du salon.
            </span>
          </span>
        </label>

        {error ? (
          <div
            role="alert"
            className="mt-5 flex items-start gap-3 rounded-[1.35rem] border border-[#E8B4B4]/70 bg-[#FFF4F3] p-4"
          >
            <span className="grid size-9 shrink-0 place-items-center rounded-full bg-white text-[#B55454] shadow-sm">
              <AlertCircle className="size-4" />
            </span>

            <div>
              <p className="text-sm font-semibold text-[#552F2F]">
                La réservation n’a pas pu être validée
              </p>

              <p className="mt-1 text-xs leading-5 text-[#865F5F]">
                {error}
              </p>
            </div>
          </div>
        ) : null}

        <button
          type="button"
          onClick={onConfirm}
          disabled={confirmDisabled}
          className={cn(
            "mt-6 flex min-h-14 w-full items-center justify-center gap-3 rounded-full px-6 py-4 text-sm font-semibold transition duration-300 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#DFAFBC]/35",
            confirmDisabled
              ? "cursor-not-allowed bg-[#D7CDD0] text-white/80"
              : "bg-gradient-to-r from-[#7A485A] via-[#A96880] to-[#CD8EA2] text-white shadow-[0_22px_45px_-22px_rgba(135,72,94,0.75)] hover:-translate-y-0.5 hover:shadow-[0_26px_55px_-24px_rgba(135,72,94,0.85)]",
          )}
        >
          {submitting ? (
            <>
              <LoaderCircle className="size-5 animate-spin" />
              Validation en cours…
            </>
          ) : (
            <>
              {requiresOnlinePayment ? (
                <LockKeyhole className="size-5" />
              ) : (
                <CalendarCheck2 className="size-5" />
              )}

              {confirmationLabel}
            </>
          )}
        </button>

        <div className="mt-4 flex flex-col items-center justify-center gap-2 text-center sm:flex-row">
          <span className="inline-flex items-center gap-1.5 text-xs text-[#8C7880]">
            <ShieldCheck className="size-3.5 text-[#A76D81]" />
            Données protégées
          </span>

          <span className="hidden text-[#C5B7BC] sm:inline">
            •
          </span>

          <span className="text-xs text-[#8C7880]">
            Aucun débit sans validation
          </span>
        </div>
      </div>
    </section>
  );
}