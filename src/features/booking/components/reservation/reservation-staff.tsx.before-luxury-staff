"use client";

import Image from "next/image";
import {
  Check,
  Crown,
  Sparkles,
  UserRound,
  UsersRound,
  WandSparkles,
} from "lucide-react";

import { cn } from "@/lib/utils";

import type {
  StaffMember,
} from "./reservation.types";

type ReservationStaffProps = {
  selectedServiceIds: string[];
  staffMembers: StaffMember[];
  compatibleStaff: StaffMember[];
  selectedStaffId: string;
  onSelectStaff: (staffId: string) => void;
};

export function ReservationStaff({
  selectedServiceIds,
  staffMembers,
  compatibleStaff,
  selectedStaffId,
  onSelectStaff,
}: ReservationStaffProps) {
  const hasSelectedServices =
    selectedServiceIds.length > 0;

  const hasCompatibleStaff =
    compatibleStaff.length > 0;

  const selectedAutomatically =
    selectedStaffId === "any";

  return (
    <section
      id="reservation-staff"
      aria-labelledby="reservation-staff-title"
      className="relative overflow-hidden rounded-[2rem] border border-[#241A1D]/8 bg-white p-5 shadow-[0_30px_90px_-55px_rgba(73,41,52,0.55)] sm:p-7 lg:p-8"
    >
      <div className="pointer-events-none absolute -right-24 -top-24 size-64 rounded-full bg-[#F7E4E8]/70 blur-3xl" />

      <div className="pointer-events-none absolute -bottom-28 -left-20 size-64 rounded-full bg-[#FFF1ED]/75 blur-3xl" />

      <div className="relative">
        <header className="flex flex-col gap-5 border-b border-[#241A1D]/8 pb-6 sm:flex-row sm:items-start sm:justify-between">
          <div className="flex items-start gap-4">
            <span className="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#D79AAF] via-[#B8768E] to-[#7A485A] text-white shadow-lg shadow-[#B8768E]/20">
              <UserRound className="size-5" />
            </span>

            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.22em] text-[#A56C80]">
                Étape 2
              </p>

              <h2
                id="reservation-staff-title"
                className="mt-1 font-serif text-3xl text-[#241A1D] sm:text-4xl"
              >
                Choisissez votre professionnelle
              </h2>

              <p className="mt-2 max-w-2xl text-sm leading-7 text-[#79676E]">
                Sélectionnez votre prothésiste préférée
                ou laissez le salon vous proposer le
                meilleur créneau disponible.
              </p>
            </div>
          </div>

          <span className="inline-flex w-fit shrink-0 items-center gap-2 rounded-full border border-[#241A1D]/8 bg-[#FFF8F7] px-4 py-2 text-xs font-semibold text-[#765A64]">
            <UsersRound className="size-4 text-[#B77C91]" />
            {staffMembers.length} professionnelle
            {staffMembers.length > 1 ? "s" : ""}
          </span>
        </header>

        {!hasSelectedServices ? (
          <div className="mt-8 rounded-[1.75rem] border border-dashed border-[#241A1D]/12 bg-[#FFF9F8] px-6 py-12 text-center">
            <span className="mx-auto grid size-14 place-items-center rounded-full bg-white text-[#A76D81] shadow-sm">
              <Sparkles className="size-6" />
            </span>

            <h3 className="mt-5 font-serif text-2xl text-[#241A1D]">
              Choisissez d’abord vos prestations
            </h3>

            <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-[#79676E]">
              Les professionnelles compatibles seront
              affichées automatiquement selon les soins
              sélectionnés.
            </p>
          </div>
        ) : !hasCompatibleStaff ? (
          <div className="mt-8 rounded-[1.75rem] border border-[#E8C98E]/60 bg-[#FFF9EA] px-6 py-10 text-center">
            <span className="mx-auto grid size-14 place-items-center rounded-full bg-white text-[#A66E20] shadow-sm">
              <WandSparkles className="size-6" />
            </span>

            <h3 className="mt-5 font-serif text-2xl text-[#4B3824]">
              Aucune professionnelle compatible
            </h3>

            <p className="mx-auto mt-2 max-w-lg text-sm leading-6 text-[#806A4D]">
              Aucune professionnelle ne réalise
              actuellement l’ensemble des prestations
              sélectionnées. Retirez une prestation ou
              contactez directement le salon.
            </p>
          </div>
        ) : (
          <div className="mt-8 grid gap-4 md:grid-cols-2">
            <button
              type="button"
              onClick={() => onSelectStaff("any")}
              aria-pressed={selectedAutomatically}
              className={cn(
                "group relative flex min-h-60 flex-col overflow-hidden rounded-[1.75rem] border p-5 text-left outline-none transition duration-300 focus-visible:ring-4 focus-visible:ring-[#DFAFBC]/30 sm:p-6",
                selectedAutomatically
                  ? "border-[#AA6C82] bg-gradient-to-br from-[#FFF8F7] via-[#FFF0F1] to-[#F6DFE5] shadow-[0_26px_60px_-35px_rgba(111,63,80,0.55)] ring-1 ring-[#C58A9E]/30"
                  : "border-[#241A1D]/8 bg-[#FFFCFB] shadow-sm hover:-translate-y-1 hover:border-[#C798A8]/60 hover:bg-white hover:shadow-[0_25px_60px_-38px_rgba(79,43,55,0.35)]",
              )}
            >
              <span className="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-[#EECBD4]/60 blur-3xl" />

              <div className="relative flex items-start justify-between gap-4">
                <span className="grid size-16 place-items-center rounded-[1.35rem] bg-[#241A1D] text-white shadow-lg shadow-[#241A1D]/15">
                  <WandSparkles className="size-7" />
                </span>

                <span
                  className={cn(
                    "grid size-10 place-items-center rounded-full border transition",
                    selectedAutomatically
                      ? "border-[#8C566A] bg-[#241A1D] text-white"
                      : "border-[#241A1D]/10 bg-white text-[#9A858D] group-hover:border-[#BC8397] group-hover:text-[#9B6378]",
                  )}
                >
                  {selectedAutomatically ? (
                    <Check className="size-5" />
                  ) : (
                    <Sparkles className="size-5" />
                  )}
                </span>
              </div>

              <div className="relative mt-5">
                <span className="inline-flex rounded-full bg-[#241A1D] px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-white">
                  Recommandé
                </span>

                <h3 className="mt-3 font-serif text-2xl leading-tight text-[#241A1D]">
                  Première professionnelle disponible
                </h3>

                <p className="mt-3 text-sm leading-7 text-[#78666D]">
                  Le salon choisit automatiquement la
                  professionnelle compatible proposant
                  le meilleur créneau.
                </p>
              </div>

              <div className="relative mt-auto border-t border-[#241A1D]/8 pt-5">
                <p className="text-xs font-semibold text-[#8C566A]">
                  Idéal pour réserver rapidement
                </p>
              </div>
            </button>

            {compatibleStaff.map((staff) => {
              const selected =
                selectedStaffId === staff.id;

              return (
                <button
                  key={staff.id}
                  type="button"
                  onClick={() =>
                    onSelectStaff(staff.id)
                  }
                  aria-pressed={selected}
                  className={cn(
                    "group relative flex min-h-60 flex-col overflow-hidden rounded-[1.75rem] border p-5 text-left outline-none transition duration-300 focus-visible:ring-4 focus-visible:ring-[#DFAFBC]/30 sm:p-6",
                    selected
                      ? "border-[#AA6C82] bg-gradient-to-br from-[#FFF8F7] via-[#FFF0F1] to-[#F6DFE5] shadow-[0_26px_60px_-35px_rgba(111,63,80,0.55)] ring-1 ring-[#C58A9E]/30"
                      : "border-[#241A1D]/8 bg-[#FFFCFB] shadow-sm hover:-translate-y-1 hover:border-[#C798A8]/60 hover:bg-white hover:shadow-[0_25px_60px_-38px_rgba(79,43,55,0.35)]",
                  )}
                >
                  <span className="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-[#F4DCE2]/60 blur-3xl" />

                  <div className="relative flex items-start justify-between gap-4">
                    <div className="relative size-16 shrink-0 overflow-hidden rounded-[1.35rem] border border-white bg-[#F4E4E8] shadow-sm">
                      {staff.image ? (
                        <Image
                          src={staff.image}
                          alt={staff.displayName}
                          fill
                          sizes="64px"
                          className="object-cover"
                        />
                      ) : (
                        <div className="grid size-full place-items-center bg-gradient-to-br from-[#E8BCC8] via-[#C9899F] to-[#895367] text-white">
                          <UserRound className="size-7" />
                        </div>
                      )}
                    </div>

                    <span
                      className={cn(
                        "grid size-10 place-items-center rounded-full border transition",
                        selected
                          ? "border-[#8C566A] bg-[#241A1D] text-white"
                          : "border-[#241A1D]/10 bg-white text-[#9A858D] group-hover:border-[#BC8397] group-hover:text-[#9B6378]",
                      )}
                    >
                      {selected ? (
                        <Check className="size-5" />
                      ) : (
                        <UserRound className="size-5" />
                      )}
                    </span>
                  </div>

                  <div className="relative mt-5">
                    <div className="flex flex-wrap items-center gap-2">
                      {staff.isOwner ? (
                        <span className="inline-flex items-center gap-1.5 rounded-full bg-[#241A1D] px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-white">
                          <Crown className="size-3" />
                          Fondatrice
                        </span>
                      ) : (
                        <span className="inline-flex rounded-full border border-[#241A1D]/8 bg-white/80 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[#86636F]">
                          Prothésiste ongulaire
                        </span>
                      )}
                    </div>

                    <h3 className="mt-3 font-serif text-2xl leading-tight text-[#241A1D]">
                      {staff.displayName}
                    </h3>

                    <p className="mt-3 line-clamp-3 text-sm leading-7 text-[#78666D]">
                      {staff.bio ??
                        (staff.isOwner
                          ? "Responsable du salon et passionnée par la mise en beauté de vos ongles."
                          : "Professionnelle attentive à vos envies et à la réalisation de prestations soignées.")}
                    </p>
                  </div>

                  <div className="relative mt-auto flex items-center justify-between gap-3 border-t border-[#241A1D]/8 pt-5">
                    <span className="text-xs font-semibold text-[#8C566A]">
                      {selected
                        ? "Professionnelle sélectionnée"
                        : "Choisir cette professionnelle"}
                    </span>

                    {selected ? (
                      <Check className="size-4 text-[#8C566A]" />
                    ) : null}
                  </div>
                </button>
              );
            })}
          </div>
        )}
      </div>
    </section>
  );
}