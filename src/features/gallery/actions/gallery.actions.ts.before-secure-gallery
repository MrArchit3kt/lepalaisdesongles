"use server";

import { revalidatePath } from "next/cache";

import {
  createGalleryItem,
  deleteGalleryItem,
  toggleFeaturedGalleryItem,
  togglePublishedGalleryItem,
  updateGalleryItem,
} from "@/features/gallery/services/gallery.service";

export type GalleryActionState = {
  success: boolean;
  message: string;
};

function revalidateGallery() {
  revalidatePath("/galerie");
  revalidatePath("/admin/galerie");
}

export async function createGalleryItemAction(
  _previousState: GalleryActionState,
  formData: FormData,
): Promise<GalleryActionState> {
  try {
    await createGalleryItem({
      title: String(formData.get("title") ?? ""),
      description: String(formData.get("description") ?? "") || null,
      categoryId: String(formData.get("categoryId") ?? "") || null,
      serviceName: String(formData.get("serviceName") ?? "") || null,
      coverUrl: String(formData.get("coverUrl") ?? ""),
      alt: String(formData.get("alt") ?? "") || null,
      priceCents: formData.get("priceCents")
        ? Number(formData.get("priceCents"))
        : null,
      durationMinutes: formData.get("durationMinutes")
        ? Number(formData.get("durationMinutes"))
        : null,
      tags: String(formData.get("tags") ?? "")
        .split(",")
        .map((tag) => tag.trim())
        .filter(Boolean),
      isFeatured: formData.get("isFeatured") === "true",
      isPublished: formData.get("isPublished") !== "false",
    });

    revalidateGallery();

    return {
      success: true,
      message: "La réalisation a été créée avec succès.",
    };
  } catch (error) {
    console.error(error);

    return {
      success: false,
      message: "Impossible de créer la réalisation.",
    };
  }
}

