import {
  MediaType,
} from "@/generated/prisma/client";
import { prisma } from "@/lib/prisma";

import {
  ensureGallerySlug,
  regenerateGallerySlug,
} from "./gallery-slug.service";

export type CreateGalleryItemInput = {
  title: string;
  description?: string | null;
  categoryId?: string | null;
  serviceName?: string | null;
  coverUrl: string;
  alt?: string | null;
  priceCents?: number | null;
  durationMinutes?: number | null;
  tags?: string[];
  isFeatured?: boolean;
  isPublished?: boolean;
  createdById?: string | null;
};

export type UpdateGalleryItemInput = {
  title?: string;
  description?: string | null;
  categoryId?: string | null;
  serviceName?: string | null;
  coverUrl?: string;
  alt?: string | null;
  priceCents?: number | null;
  durationMinutes?: number | null;
  tags?: string[];
  isFeatured?: boolean;
  isPublished?: boolean;
};

export async function createGalleryItem(
  input: CreateGalleryItemInput,
) {
  const slug = await ensureGallerySlug(input.title);

  return prisma.galleryItem.create({
    data: {
      title: input.title,
      slug,
      description: input.description,
      categoryId: input.categoryId,
      serviceName: input.serviceName,
      coverUrl: input.coverUrl,
      alt: input.alt,
      priceCents: input.priceCents,
      durationMinutes: input.durationMinutes,
      tags: input.tags ?? [],
      isFeatured: input.isFeatured ?? false,
      isPublished: input.isPublished ?? true,
      publishedAt: input.isPublished ? new Date() : null,
      createdById: input.createdById,
    },
    include: {
      category: true,
      media: true,
      createdBy: true,
    },
  });
}

export async function updateGalleryItem(
  id: string,
  input: UpdateGalleryItemInput,
) {
  const current = await prisma.galleryItem.findUnique({
    where: {
      id,
    },
  });

  if (!current) {
    throw new Error("Galerie introuvable.");
  }

  let slug = current.slug;

  if (
    input.title &&
    input.title.trim() !== current.title
  ) {
    slug = await regenerateGallerySlug(
      input.title,
      id,
    );
  }

  return prisma.galleryItem.update({
    where: {
      id,
    },

    data: {
      title: input.title,
      slug,
      description: input.description,
      categoryId: input.categoryId,
      serviceName: input.serviceName,
      coverUrl: input.coverUrl,
      alt: input.alt,
      priceCents: input.priceCents,
      durationMinutes: input.durationMinutes,
      tags: input.tags,
      isFeatured: input.isFeatured,
      isPublished: input.isPublished,
      publishedAt:
        input.isPublished === true
          ? current.publishedAt ?? new Date()
          : input.isPublished === false
          ? null
          : current.publishedAt,
    },

    include: {
      category: true,
      media: true,
      createdBy: true,
    },
  });
}export async function deleteGalleryItem(
    id: string,
  ) {
    return prisma.$transaction(async (tx) => {
      await tx.galleryMedia.deleteMany({
        where: {
          galleryItemId: id,
        },
      });
  
      return tx.galleryItem.delete({
        where: {
          id,
        },
      });
    });
  }
  
  export async function publishGalleryItem(
    id: string,
  ) {
    return prisma.galleryItem.update({
      where: {
        id,
      },
      data: {
        isPublished: true,
        publishedAt: new Date(),
      },
    });
  }
  
  export async function unpublishGalleryItem(
    id: string,
  ) {
    return prisma.galleryItem.update({
      where: {
        id,
      },
      data: {
        isPublished: false,
        publishedAt: null,
      },
    });
  }
  
  export async function togglePublishedGalleryItem(
    id: string,
  ) {
    const item = await prisma.galleryItem.findUnique({
      where: {
        id,
      },
      select: {
        isPublished: true,
        publishedAt: true,
      },
    });
  
    if (!item) {
      throw new Error("Galerie introuvable.");
    }
  
    return prisma.galleryItem.update({
      where: {
        id,
      },
      data: {
        isPublished: !item.isPublished,
        publishedAt: item.isPublished
          ? null
          : item.publishedAt ?? new Date(),
      },
    });
  }
  
  export async function toggleFeaturedGalleryItem(
