export type GalleryMediaType =
  | "IMAGE"
  | "VIDEO";

export type GalleryImage = {
  id: string;

  url: string;

  thumbnailUrl?: string | null;

  alt?: string | null;

  width?: number | null;

  height?: number | null;

  type: GalleryMediaType;

  sortOrder: number;

  isCover: boolean;

  file?: File;

  progress?: number;

  uploading?: boolean;

  error?: string | null;
};

export type GalleryCategorySummary = {
  id: string;
  name: string;
  slug: string;
};

export type GalleryMediaSummary = {
  id: string;
  url: string;
  thumbnailUrl?: string | null;
  alt?: string | null;
  type: GalleryMediaType;
  sortOrder: number;
};

export type GalleryItemWithMedia = {
  id: string;
  title: string;
  slug: string;
  description?: string | null;
  coverUrl: string;
  serviceName?: string | null;
  priceCents?: number | null;
  durationMinutes?: number | null;
  tags: string[];
  isFeatured: boolean;
  isPublished: boolean;
  publishedAt?: Date | null;
  sortOrder: number;
  viewCount: number;
  createdAt: Date;
  updatedAt: Date;

  category?: GalleryCategorySummary | null;

  media: GalleryMediaSummary[];

  coverImage?: GalleryMediaSummary | null;
