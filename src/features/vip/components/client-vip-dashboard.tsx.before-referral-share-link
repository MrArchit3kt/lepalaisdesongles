      </p>

      <div
        className="mt-4 rounded-2xl p-4"
        style={{
          backgroundColor:
            `${rewardColor}14`,
        }}
      >
        <p
          className="text-xs font-bold uppercase tracking-wide"
          style={{
            color:
              rewardColor,
          }}
        >
          Votre avantage
        </p>

        <p className="mt-1 text-lg font-black text-zinc-950">
          {getRewardValue(
            clientReward,
